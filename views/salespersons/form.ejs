<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'salespersons', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">
      <i class="bi bi-person-badge me-2 text-primary"></i><%= sp ? 'Edit Salesperson' : 'Add Salesperson' %>
    </h4>
    <a href="<%= sp ? '/salespersons/' + sp.id : '/salespersons' %>" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i>Back
    </a>
  </div>

  <% if (flash.error) { %><div class="alert alert-danger"><%= flash.error %></div><% } %>

  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <form method="POST" action="<%= sp ? '/salespersons/' + sp.id + '/update' : '/salespersons' %>">
            <% if (sp) { %>
            <div class="mb-3">
              <label class="form-label fw-semibold">Status</label>
              <select name="active" class="form-select">
                <option value="1" <%= (sp.active===1||sp.active===undefined)?'selected':'' %>>Active</option>
                <option value="0" <%= sp.active===0?'selected':'' %>>Inactive</option>
              </select>
            </div>
            <% } %>
            <div class="mb-3">
              <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control" required
                value="<%= sp?.name || '' %>" placeholder="e.g. Rahul Sharma">
            </div>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Phone</label>
                <input type="text" name="phone" class="form-control"
                  value="<%= sp?.phone || '' %>" placeholder="+91XXXXXXXXXX">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Email</label>
                <input type="email" name="email" class="form-control"
                  value="<%= sp?.email || '' %>" placeholder="name@example.com">
              </div>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Territory / Area</label>
                <input type="text" name="territory" class="form-control"
                  value="<%= sp?.territory || '' %>" placeholder="e.g. Meerut, Hapur">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Monthly Target (₹)</label>
                <div class="input-group">
                  <span class="input-group-text">₹</span>
                  <input type="number" name="target_monthly" class="form-control" min="0" step="1000"
                    value="<%= sp?.target_monthly || '' %>" placeholder="0">
                </div>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Notes</label>
              <textarea name="notes" class="form-control" rows="3"
                placeholder="Any notes about this salesperson..."><%= sp?.notes || '' %></textarea>
            </div>
            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-lg me-1"></i><%= sp ? 'Update' : 'Add Salesperson' %>
              </button>
              <a href="<%= sp ? '/salespersons/' + sp.id : '/salespersons' %>" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
