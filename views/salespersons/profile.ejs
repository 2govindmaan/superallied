<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'salespersons', user }) %>
<div class="main-content">

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error)   { %><div class="alert alert-danger  alert-dismissible"><%= flash.error   %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div class="d-flex align-items-center gap-3">
      <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold"
        style="width:56px;height:56px;font-size:22px">
        <%= sp.name.charAt(0).toUpperCase() %>
      </div>
      <div>
        <h4 class="mb-0 fw-bold"><%= sp.name %>
          <span class="badge <%= sp.active ? 'bg-success' : 'bg-secondary' %> ms-2" style="font-size:11px">
            <%= sp.active ? 'Active' : 'Inactive' %>
          </span>
        </h4>
        <div class="text-muted small">
          <% if (sp.phone) { %><i class="bi bi-telephone me-1"></i><%= sp.phone %>&nbsp;&nbsp;<% } %>
          <% if (sp.email) { %><i class="bi bi-envelope me-1"></i><%= sp.email %>&nbsp;&nbsp;<% } %>
          <% if (sp.territory) { %><i class="bi bi-geo-alt me-1"></i><%= sp.territory %><% } %>
        </div>
      </div>
    </div>
    <div class="d-flex gap-2">
      <a href="/salespersons/<%= sp.id %>/edit" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-pencil me-1"></i>Edit
      </a>
      <% if (user && user.role === 'admin') { %>
      <form method="POST" action="/salespersons/<%= sp.id %>/toggle" class="d-inline">
        <button class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-toggle-<%= sp.active ? 'on' : 'off' %> me-1"></i><%= sp.active ? 'Deactivate' : 'Activate' %>
        </button>
      </form>
      <form method="POST" action="/salespersons/<%= sp.id %>/delete" class="d-inline"
        onsubmit="return confirm('Delete <%= sp.name %>? Their quotations will be unlinked.')">
        <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
      </form>
      <% } %>
      <a href="/salespersons" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back
      </a>
    </div>
  </div>

  <!-- KPI Cards -->
  <%
    const spareConfirmed = spareQuotes.filter(q=>q.status==='confirmed');
    const spareConvRate = spareTotals.count ? Math.round((spareConfirmed.length/spareTotals.count)*100) : 0;
    const thisMonthVal = spareQuotes.filter(q=>{
      const d = new Date(q.created_at);
      const n = new Date();
      return d.getMonth()===n.getMonth() && d.getFullYear()===n.getFullYear();
    }).reduce((a,q)=>a+(q.grand_total||0),0);
    const targetAchieved = sp.target_monthly ? Math.min(Math.round((thisMonthVal/sp.target_monthly)*100),999) : null;
  %>
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm text-center py-3">
        <div class="fs-2 fw-bold text-primary"><%= spareTotals.count %></div>
        <div class="text-muted small">Spare Quotes</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm text-center py-3">
        <div class="fs-2 fw-bold text-success">₹<%= formatINR(spareTotals.value) %></div>
        <div class="text-muted small">Total Spare Value</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm text-center py-3">
        <div class="fs-2 fw-bold text-warning"><%= spareConvRate %>%</div>
        <div class="text-muted small">Conversion Rate</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <% if (targetAchieved !== null) { %>
      <div class="card border-0 shadow-sm text-center py-3">
        <div class="fs-2 fw-bold <%= targetAchieved>=100?'text-success':'text-danger' %>"><%= targetAchieved %>%</div>
        <div class="text-muted small">This Month vs Target</div>
        <div class="px-3 mt-1">
          <div class="progress" style="height:4px">
            <div class="progress-bar <%= targetAchieved>=100?'bg-success':'bg-warning' %>"
              style="width:<%= Math.min(targetAchieved,100) %>%"></div>
          </div>
        </div>
      </div>
      <% } else { %>
      <div class="card border-0 shadow-sm text-center py-3">
        <div class="fs-2 fw-bold text-info"><%= machineTotals.count %></div>
        <div class="text-muted small">Machine Quotes</div>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Status breakdown + notes -->
  <div class="row g-3 mb-4">
    <div class="col-md-8">
      <!-- Monthly trend mini-chart -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold small">Monthly Spare Quotations (last 12 months)</div>
        <div class="card-body" style="height:180px">
          <canvas id="trendChart"></canvas>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white fw-semibold small">Status Breakdown</div>
        <div class="card-body">
          <% const statuses = ['draft','sent','confirmed','cancelled']; %>
          <% const colors = {draft:'secondary',sent:'info',confirmed:'success',cancelled:'danger'}; %>
          <% statuses.forEach(s => { %>
          <% const cnt = spareTotals[s] || 0; %>
          <% if (cnt > 0) { %>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge bg-<%= colors[s] %>-subtle text-<%= colors[s] %> text-capitalize"><%= s %></span>
            <span class="fw-semibold"><%= cnt %></span>
          </div>
          <% } %>
          <% }) %>
          <% if (sp.notes) { %>
          <hr class="my-2">
          <div class="small text-muted"><i class="bi bi-sticky me-1"></i><%= sp.notes %></div>
          <% } %>
          <% if (sp.target_monthly) { %>
          <hr class="my-2">
          <div class="small"><b>Monthly Target:</b> ₹<%= formatINR(sp.target_monthly) %></div>
          <div class="small"><b>This Month:</b> ₹<%= formatINR(thisMonthVal) %></div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabs: Spare Quotations / Machine Quotations -->
  <ul class="nav nav-tabs mb-3" id="quoteTabs">
    <li class="nav-item">
      <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#spareTab">
        Spare Quotations <span class="badge bg-primary ms-1"><%= spareQuotes.length %></span>
      </button>
    </li>
    <li class="nav-item">
      <button class="nav-link" data-bs-toggle="tab" data-bs-target="#machineTab">
        Machine Quotations <span class="badge bg-info ms-1"><%= machineQuotes.length %></span>
      </button>
    </li>
  </ul>

  <div class="tab-content">
    <!-- Spare Quotations Tab -->
    <div class="tab-pane fade show active" id="spareTab">
      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
              <tr>
                <th>Quotation No</th>
                <th>Date</th>
                <th>Customer</th>
                <th>Machine No</th>
                <th class="text-center">Status</th>
                <th class="text-end">Value</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% if (!spareQuotes.length) { %>
              <tr><td colspan="7" class="text-center text-muted py-3">No spare quotations linked to this salesperson.</td></tr>
              <% } %>
              <% const stBadge = {draft:'secondary',sent:'info',confirmed:'success',cancelled:'danger',lost:'dark'}; %>
              <% spareQuotes.forEach(q => { %>
              <tr>
                <td><a href="/spare-quotations/<%= q.id %>" class="fw-semibold text-decoration-none"><%= q.quotation_no %></a></td>
                <td class="text-muted"><%= new Date(q.quotation_date||q.created_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></td>
                <td><%= q.customer_name %></td>
                <td class="font-monospace small"><%= q.machine_no || '—' %></td>
                <td class="text-center"><span class="badge bg-<%= stBadge[q.status]||'secondary' %>"><%= q.status %></span></td>
                <td class="text-end fw-semibold">₹<%= formatINR(q.grand_total) %></td>
                <td><a href="/spare-quotations/<%= q.id %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Machine Quotations Tab -->
    <div class="tab-pane fade" id="machineTab">
      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
              <tr>
                <th>Quotation No</th>
                <th>Date</th>
                <th>Customer</th>
                <th>Machine</th>
                <th class="text-center">Status</th>
                <th class="text-end">Value</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% if (!machineQuotes.length) { %>
              <tr><td colspan="7" class="text-center text-muted py-3">No machine quotations linked to this salesperson.</td></tr>
              <% } %>
              <% machineQuotes.forEach(q => { %>
              <tr>
                <td><a href="/quotations/<%= q.id %>" class="fw-semibold text-decoration-none"><%= q.quotation_number %></a></td>
                <td class="text-muted"><%= new Date(q.created_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></td>
                <td><%= q.customer_name || '—' %></td>
                <td class="small"><%= q.machine_model || '—' %></td>
                <td class="text-center"><span class="badge bg-<%= stBadge[q.status]||'secondary' %>"><%= q.status %></span></td>
                <td class="text-end fw-semibold">₹<%= formatINR(q.total_price||0) %></td>
                <td><a href="/quotations/<%= q.id %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
const monthly = <%- JSON.stringify(monthly) %>;
const labels  = monthly.map(m => m.month);
const values  = monthly.map(m => m.value);
const counts  = monthly.map(m => m.count);
const ctx = document.getElementById('trendChart').getContext('2d');
new Chart(ctx, {
  type: 'bar',
  data: {
    labels,
    datasets: [{
      label: 'Value (₹)',
      data: values,
      backgroundColor: 'rgba(13,110,253,0.15)',
      borderColor: 'rgba(13,110,253,0.7)',
      borderWidth: 1.5,
      yAxisID: 'y'
    },{
      label: 'Count',
      data: counts,
      type: 'line',
      borderColor: '#f59e0b',
      backgroundColor: 'transparent',
      pointRadius: 4,
      tension: 0.3,
      yAxisID: 'y1'
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      y:  { position: 'left',  ticks: { font:{size:9} }, grid:{color:'#f0f0f0'} },
      y1: { position: 'right', ticks: { font:{size:9} }, grid:{display:false} }
    }
  }
});
</script>
</body></html>
