<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'visits', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-geo-alt me-2 text-danger"></i>My Field Visits</h4>
    <span class="badge bg-primary"><%= todayCount %> today</span>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light"><tr><th>Date & Time</th><th>Customer</th><th>Location</th><th>Remarks</th></tr></thead>
        <tbody>
          <% visits.forEach(v => { %>
          <tr>
            <td class="small"><%= new Date(v.visit_time).toLocaleString('en-IN',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) %></td>
            <td class="fw-semibold"><%= v.customer_name %></td>
            <td class="small">
              <% if (v.lat) { %><a href="https://maps.google.com/?q=<%= v.lat %>,<%= v.lng %>" target="_blank" class="text-decoration-none"><i class="bi bi-geo-alt-fill text-danger"></i> Map</a><% } else { %>—<% } %>
            </td>
            <td class="small text-muted"><%= v.remarks || '—' %></td>
          </tr>
          <% }) %>
          <% if (!visits.length) { %><tr><td colspan="4" class="text-center text-muted py-4">No field visits yet.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
