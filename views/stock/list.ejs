<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'stock', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-boxes me-2 text-success"></i>Stock Availability</h4>
    <div class="d-flex gap-2">
      <a href="/stock/template" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download me-1"></i>Template</a>
      <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#importModal"><i class="bi bi-upload me-1"></i>Import</button>
      <a href="/stock/export" class="btn btn-sm btn-success"><i class="bi bi-file-earmark-excel me-1"></i>Export</a>
    </div>
  </div>

  <% if (flash.success) { %>
  <div class="alert alert-success alert-dismissible d-flex align-items-center gap-2">
    <%= flash.success %>
    <% if (flash.failedCount) { %>
    <a href="/stock/import/failed" class="btn btn-sm btn-outline-danger ms-2">Download Failed (<%= flash.failedCount %>)</a>
    <% } %>
    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
  </div>
  <% } %>
  <% if (flash.error) { %>
  <div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  <% } %>

  <!-- Filters -->
  <form method="GET" action="/stock" class="card border-0 shadow-sm mb-3 p-3">
    <div class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small mb-1">Part Number</label>
        <input type="text" name="part_number" class="form-control form-control-sm" value="<%= filters.part_number %>" placeholder="Search...">
      </div>
      <div class="col-md-3">
        <label class="form-label small mb-1">Part Name / Description</label>
        <input type="text" name="part_name" class="form-control form-control-sm" value="<%= filters.part_name %>" placeholder="Search...">
      </div>
      <div class="col-md-2">
        <label class="form-label small mb-1">Category</label>
        <select name="category" class="form-select form-select-sm">
          <option value="">All Categories</option>
          <% categories.forEach(c => { %>
          <option value="<%= c %>" <%= filters.category===c?'selected':'' %>><%= c %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <div class="form-check mb-1">
          <input class="form-check-input" type="checkbox" name="out_of_stock" value="1" id="oos" <%= filters.out_of_stock==='1'?'checked':'' %>>
          <label class="form-check-label small" for="oos">Out of Stock Only</label>
        </div>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-primary flex-fill"><i class="bi bi-search me-1"></i>Filter</button>
        <a href="/stock" class="btn btn-sm btn-outline-secondary">Clear</a>
      </div>
    </div>
  </form>

  <!-- Stock Grid -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
      <span class="small fw-semibold"><%= total %> parts</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th style="width:130px">Part No.</th>
            <th>Description</th>
            <th>Category</th>
            <th class="text-center" style="width:110px">Stock</th>
            <th>Remarks</th>
            <th>Last Updated</th>
            <th>Updated By</th>
            <th style="width:60px"></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(r => { %>
          <tr>
            <td class="font-monospace small fw-semibold"><%= r.part_number %></td>
            <td class="small"><%= r.description %></td>
            <td class="small"><%= r.category || '—' %></td>
            <td class="text-center">
              <% if (r.stock_quantity <= 0) { %>
              <span class="badge bg-danger">Out of Stock</span>
              <% } else if (r.stock_quantity <= 5) { %>
              <span class="badge bg-warning text-dark"><%= r.stock_quantity %> (Low)</span>
              <% } else { %>
              <span class="badge bg-success"><%= r.stock_quantity %></span>
              <% } %>
            </td>
            <td class="small text-muted"><%= r.remarks || '—' %></td>
            <td class="small text-muted"><%= r.updated_at ? new Date(r.updated_at).toLocaleDateString('en-IN') : '—' %></td>
            <td class="small text-muted"><%= r.updated_by_name || '—' %></td>
            <td>
              <button class="btn btn-sm btn-outline-primary py-0 px-2"
                onclick="openEdit(<%= r.id %>, '<%= (r.part_number||'').replace(/'/g,"\\'") %>', '<%= (r.description||'').replace(/'/g,"\\'") %>', <%= r.stock_quantity %>, '<%= (r.remarks||'').replace(/'/g,"\\'") %>', '<%= (r.category||'').replace(/'/g,"\\'") %>')">
                <i class="bi bi-pencil"></i>
              </button>
            </td>
          </tr>
          <% }) %>
          <% if (!rows.length) { %>
          <tr><td colspan="8" class="text-center text-muted py-4">No parts found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination -->
  <% if (pages > 1) { %>
  <nav class="mt-3 d-flex justify-content-center">
    <ul class="pagination pagination-sm mb-0">
      <% for (let p = 1; p <= pages; p++) { %>
      <li class="page-item <%= p===page?'active':'' %>">
        <a class="page-link" href="/stock?<%= new URLSearchParams({...filters, page: p}) %>"><%= p %></a>
      </li>
      <% } %>
    </ul>
  </nav>
  <% } %>
</div>

<!-- Edit Stock Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title fw-bold">Update Stock</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="editForm" method="POST">
        <div class="modal-body">
          <p class="mb-1 small fw-semibold" id="editPartLabel"></p>
          <p class="mb-3 small text-muted" id="editPartDesc"></p>
          <div class="mb-2">
            <label class="form-label small mb-1">Category</label>
            <input type="text" name="category" id="editCategory" class="form-control form-control-sm" placeholder="e.g. Bearings">
          </div>
          <div class="mb-2">
            <label class="form-label small mb-1">New Quantity</label>
            <input type="number" name="stock_quantity" id="editQty" class="form-control form-control-sm" min="0" required>
          </div>
          <div class="mb-2">
            <label class="form-label small mb-1">Remarks</label>
            <textarea name="remarks" id="editRemarks" class="form-control form-control-sm" rows="2"></textarea>
          </div>
        </div>
        <div class="modal-footer py-2">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title fw-bold">Bulk Import Stock</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/stock/import/excel" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="alert alert-info small mb-3">
            <strong>Required columns:</strong> <code>Part Number</code>, <code>Stock Quantity</code><br>
            <strong>Optional:</strong> <code>Remarks</code>, <code>Category</code><br>
            Part Number must match an existing part in the system.
            <a href="/stock/template" class="d-block mt-1">Download template</a>
          </div>
          <input type="file" name="file" class="form-control" accept=".xlsx,.xls" required>
        </div>
        <div class="modal-footer py-2">
          <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-upload me-1"></i>Import</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function openEdit(id, partNum, desc, qty, remarks, category) {
  document.getElementById('editForm').action = '/stock/' + id + '/update';
  document.getElementById('editPartLabel').textContent = partNum;
  document.getElementById('editPartDesc').textContent  = desc;
  document.getElementById('editQty').value      = qty;
  document.getElementById('editRemarks').value  = remarks;
  document.getElementById('editCategory').value = category;
  new bootstrap.Modal(document.getElementById('editModal')).show();
}
</script>
</body></html>
