<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'users', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-person-badge me-2 text-danger"></i>Users</h4>
    <a href="/users/new" class="btn btn-danger"><i class="bi bi-plus-lg me-1"></i>Add Staff</a>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error)   { %><div class="alert alert-danger  alert-dismissible"><%= flash.error   %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Username</th>
            <th>Full Name</th>
            <th>Role</th>
            <th>Created</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
          <tr>
            <td class="fw-semibold font-monospace"><%= u.username %></td>
            <td><%= u.full_name || '—' %></td>
            <td>
              <% const rb = {admin:'bg-danger',manager:'bg-warning text-dark',sales:'bg-info text-dark',office:'bg-primary',hr:'bg-purple',service:'bg-secondary',staff:'bg-secondary',employee:'bg-success'}; %>
              <% const rl = {admin:'Admin',manager:'Manager',sales:'Sales',office:'Office',hr:'HR',service:'Service',staff:'Staff',employee:'Employee'}; %>
              <span class="badge <%= rb[u.role]||'bg-secondary' %>"><%= rl[u.role]||u.role %></span>
            </td>
            <td class="text-muted small"><%= new Date(u.created_at).toLocaleDateString('en-IN') %></td>
            <td class="text-end">
              <% if (u.id !== user.id) { %>
              <form method="POST" action="/users/<%= u.id %>/delete" class="d-inline"
                    onsubmit="return confirm('Delete user <%= u.username %>? This cannot be undone.')">
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
              </form>
              <% } else { %>
              <span class="text-muted small">(you)</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
          <% if (!users.length) { %>
          <tr><td colspan="5" class="text-center text-muted py-4">No users found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card border-0 shadow-sm mt-4">
    <div class="card-header bg-white fw-semibold small">Role Access Summary</div>
    <div class="card-body small">
      <table class="table table-sm table-bordered mb-0" style="font-size:12px">
        <thead class="table-light"><tr><th>Role</th><th>Access</th></tr></thead>
        <tbody>
          <tr><td><span class="badge bg-danger">Admin</span></td><td>Full access — all modules, approvals, settings, user management</td></tr>
          <tr><td><span class="badge bg-info text-dark">Sales</span></td><td>Machine Quotations, Lead Management, Field Visits, Attendance, Leaves, Salary, Expenses, ID Card</td></tr>
          <tr><td><span class="badge bg-primary">Office</span></td><td>Machine + Spare Quotations, Sold Machines, Parts Master, Parts Reports, Lead Management, Attendance, Leaves, Salary, Expenses, ID Card</td></tr>
          <tr><td><span class="badge bg-warning text-dark">Manager</span></td><td>All Sales + Spares access, HR dashboard, attendance/leave/salary admin</td></tr>
          <tr><td><span class="badge bg-secondary">HR</span></td><td>HR Dashboard, employee management, attendance, leave approvals</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
