<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'machines', user }) %>
<div class="main-content">
  <% const isAdmin = user && user.role === 'admin'; %>
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">Machine Catalog
      <% if (isAdmin) { %><small class="text-muted fs-6 ms-2">(Price list w.e.f. 01.05.2026)</small><% } %>
    </h4>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <% if (isAdmin) { %><p class="text-muted small mb-3">Click <strong>Edit</strong> on any machine to update its price, specs, or active status.</p><% } %>

  <% const series = [...new Set(machines.map(m=>m.model_series))];
     series.forEach(s => { %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold"><%= s %></div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Model</th><th>Engine</th><th>Tyres</th>
            <% if (isAdmin) { %><th>Basic Price</th><% } %>
            <th>Active</th>
            <% if (isAdmin) { %><th></th><% } %>
          </tr>
        </thead>
        <tbody>
          <% machines.filter(m=>m.model_series===s).forEach(m => { %>
          <tr class="<%= m.active ? '' : 'text-muted' %>">
            <td>
              <div class="fw-semibold"><%= m.display_name %></div>
              <small class="font-monospace text-muted"><%= m.model_code %></small>
            </td>
            <td class="small"><%= m.engine %></td>
            <td class="small"><%= m.front_tyre %> / <%= m.rear_tyre %></td>
            <% if (isAdmin) { %>
            <td class="fw-bold text-success">₹<%= formatINR(m.basic_price) %></td>
            <% } %>
            <td><span class="badge <%= m.active ? 'bg-success' : 'bg-secondary' %>"><%= m.active ? 'Yes' : 'No' %></span></td>
            <% if (isAdmin) { %>
            <td>
              <button class="btn btn-sm btn-outline-secondary" onclick="openEdit(<%= JSON.stringify(m) %>)">
                <i class="bi bi-pencil"></i> Edit
              </button>
            </td>
            <% } %>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% }) %>
</div>

<% if (isAdmin) { %>
<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">Edit Machine</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="editForm" method="POST">
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label">Display Name</label>
              <input type="text" name="display_name" id="e_name" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label">Basic Price (₹)</label>
              <input type="number" name="basic_price" id="e_price" class="form-control">
            </div>
            <div class="col-md-6">
              <label class="form-label">Engine</label>
              <input type="text" name="engine" id="e_engine" class="form-control">
            </div>
            <div class="col-md-6">
              <label class="form-label">Transmission</label>
              <input type="text" name="transmission" id="e_trans" class="form-control">
            </div>
            <div class="col-md-6">
              <label class="form-label">Front Tyre</label>
              <input type="text" name="front_tyre" id="e_ftyre" class="form-control">
            </div>
            <div class="col-md-6">
              <label class="form-label">Rear Tyre</label>
              <input type="text" name="rear_tyre" id="e_rtyre" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label">Battery</label>
              <input type="text" name="battery" id="e_batt" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label">Weight</label>
              <input type="text" name="weight" id="e_weight" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label">Bucket</label>
              <input type="text" name="bucket" id="e_bucket" class="form-control">
            </div>
            <div class="col-12">
              <label class="form-label">Warranty</label>
              <input type="text" name="warranty" id="e_warranty" class="form-control">
            </div>
            <div class="col-auto">
              <div class="form-check form-switch mt-2">
                <input class="form-check-input" type="checkbox" name="active" id="e_active">
                <label class="form-check-label" for="e_active">Active (visible in quotation form)</label>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<% } /* end isAdmin edit modal */ %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function openEdit(m) {
  document.getElementById('editForm').action = '/machines/' + m.id;
  document.getElementById('e_name').value    = m.display_name;
  document.getElementById('e_price').value   = m.basic_price;
  document.getElementById('e_engine').value  = m.engine;
  document.getElementById('e_trans').value   = m.transmission;
  document.getElementById('e_ftyre').value   = m.front_tyre;
  document.getElementById('e_rtyre').value   = m.rear_tyre;
  document.getElementById('e_batt').value    = m.battery;
  document.getElementById('e_weight').value  = m.weight;
  document.getElementById('e_bucket').value  = m.bucket;
  document.getElementById('e_warranty').value= m.warranty;
  document.getElementById('e_active').checked= !!m.active;
  new bootstrap.Modal(document.getElementById('editModal')).show();
}
</script>
</body></html>
