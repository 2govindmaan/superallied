<%
  const salesActive  = ['enquiries','visits','quotations','customers','machines','calculator','salespersons','route'].includes(active);
  const sparesActive = ['sold-machines','spare-quotations','spare-parts','spare-reports','stock'].includes(active);
  const hrActive     = ['attendance','leaves','salary','id-card','profile','notifications','users','settings','hr','expenses'].includes(active);
  const isAdmin      = user && user.role === 'admin';
  const isMgr        = user && (user.role === 'admin' || user.role === 'manager');
%>

<!-- Mobile Top Bar -->
<div class="mobile-topbar">
  <button class="hamburger-btn" onclick="toggleSidebar()" aria-label="Open menu">
    <i class="bi bi-list"></i>
  </button>
  <span class="app-title">SUPER ALLIED</span>
  <a href="/logout" class="btn btn-sm btn-outline-light ms-auto">
    <i class="bi bi-box-arrow-right"></i>
  </a>
</div>

<!-- Backdrop overlay -->
<div id="sidebarBackdrop" class="sidebar-backdrop" onclick="toggleSidebar()"></div>

<!-- Sidebar -->
<nav id="sidebar" class="d-flex flex-column text-white">

  <!-- Mobile close -->
  <div class="d-flex justify-content-between align-items-center d-lg-none px-3 pt-3 pb-2 border-bottom border-secondary">
    <span class="fw-semibold text-white-50 small text-uppercase" style="font-size:11px">Menu</span>
    <button onclick="toggleSidebar()" class="btn btn-sm text-white border-0 p-0">
      <i class="bi bi-x-lg fs-5"></i>
    </button>
  </div>

  <!-- Brand -->
  <a href="/" class="d-flex align-items-center px-3 pt-3 pb-1 text-white text-decoration-none gap-2">
    <div class="brand-logo flex-shrink-0">SA</div>
    <div>
      <div class="fw-bold lh-1">Super Allied</div>
      <small class="text-white-50" style="font-size:10px">Bull CE Dealer</small>
    </div>
  </a>
  <div class="text-center pb-2">
    <img src="/bull-logo.jpg" alt="Bull" style="height:30px;opacity:0.85;border-radius:4px;" onerror="this.style.display='none'">
  </div>
  <hr class="border-secondary my-0">

  <!-- Universal Search Bar -->
  <div class="p-2 border-bottom border-secondary">
    <div class="search-input-wrapper">
      <div class="input-group input-group-sm">
        <span class="input-group-text bg-secondary border-0"><i class="bi bi-search text-white"></i></span>
        <input type="text" class="form-control border-0" id="universalSearch" placeholder="Search..." autocomplete="off">
      </div>
      <div class="search-dropdown" id="searchDropdown"></div>
    </div>
  </div>

  <!-- Nav -->
  <div class="flex-grow-1 overflow-auto px-2 py-2 sidebar-scroll">

    <!-- Dashboard -->
    <a href="/" class="sb-top-link nav-link text-white d-flex align-items-center gap-2 px-2 py-2 rounded mb-1 <%= active==='dashboard'?'active':'' %>" onclick="closeSidebarOnMobile()">
      <i class="bi bi-speedometer2"></i><span class="fw-semibold">Dashboard</span>
    </a>

    <!-- ── SALES ──────────────────────────────────── -->
    <div class="sb-section-hdr" onclick="toggleSection('sales')">
      <i class="bi bi-chevron-right sb-chevron <%= salesActive?'open':'' %>"></i>
      <i class="bi bi-graph-up-arrow"></i>SALES
    </div>
    <div class="sb-section-body<%= salesActive?' show':'' %>" id="section-sales">
      <% if (isAdmin || isMgr || hasPerm('enquiries')) { %>
      <a href="/enquiries" class="sb-link nav-link <%= active==='enquiries'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-funnel-fill"></i>Enquiries
      </a>
      <a href="/enquiries/pipeline" class="sb-link nav-link" onclick="closeSidebarOnMobile()">
        <i class="bi bi-kanban"></i>Enquiry Pipeline
      </a>
      <a href="/enquiries/dashboard" class="sb-link nav-link" onclick="closeSidebarOnMobile()">
        <i class="bi bi-bar-chart-fill"></i>Enquiry Dashboard
      </a>
      <% } %>
      <% if (isAdmin || hasPerm('field_visit')) { %>
      <a href="/visits" class="sb-link nav-link <%= active==='visits'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-geo-alt-fill"></i>Field Visits
      </a>
      <% } %>
      <% if (isAdmin || hasPerm('customers')) { %>
      <a href="/customers" class="sb-link nav-link <%= active==='customers'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-people-fill"></i>Customers
      </a>
      <% } %>
      <% if (isAdmin || hasPerm('quotations')) { %>
      <a href="/quotations" class="sb-link nav-link <%= active==='quotations'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-file-earmark-text-fill"></i>Machine Quotations
      </a>
      <% } %>
      <% if (isAdmin || isMgr) { %>
      <a href="/salespersons" class="sb-link nav-link <%= active==='salespersons'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-person-badge-fill"></i>Salespersons
      </a>
      <a href="/salespersons/reports/summary" class="sb-link nav-link" onclick="closeSidebarOnMobile()">
        <i class="bi bi-bar-chart-fill"></i>Sales Reports
      </a>
      <% } %>
      <% if (isMgr) { %>
      <a href="/machines" class="sb-link nav-link <%= active==='machines'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-sliders2"></i>Machine Master
      </a>
      <% } %>
      <% if (isAdmin) { %>
      <a href="/calculator" class="sb-link nav-link <%= active==='calculator'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-calculator-fill"></i>Profit Calculator
      </a>
      <% } %>
    </div>

    <!-- ── SPARES ─────────────────────────────────── -->
    <div class="sb-section-hdr" onclick="toggleSection('spares')">
      <i class="bi bi-chevron-right sb-chevron <%= sparesActive?'open':'' %>"></i>
      <i class="bi bi-box-seam-fill"></i>SPARES
    </div>
    <div class="sb-section-body<%= sparesActive?' show':'' %>" id="section-spares">
      <% if (isAdmin || hasPerm('sold_machines')) { %>
      <a href="/sold-machines" class="sb-link nav-link <%= active==='sold-machines'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-hdd-rack-fill"></i>Sold Machines
      </a>
      <% } %>
      <% if (isAdmin || hasPerm('spare_quotations')) { %>
      <a href="/spare-quotations" class="sb-link nav-link <%= active==='spare-quotations'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-receipt-cutoff"></i>Spare Quotations
      </a>
      <% } %>
      <% if (isAdmin || hasPerm('spare_parts')) { %>
      <a href="/spare-parts" class="sb-link nav-link <%= active==='spare-parts'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-boxes"></i>Parts Master
      </a>
      <% } %>
      <% if (isAdmin || hasPerm('spare_reports')) { %>
      <a href="/spare-quotations/reports/summary" class="sb-link nav-link <%= active==='spare-reports'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-bar-chart-line-fill"></i>Parts Reports
      </a>
      <% } %>
      <div class="sb-sub-label">Masters</div>
      <% if (isAdmin || hasPerm('stock')) { %>
      <a href="/stock" class="sb-link nav-link <%= active==='stock'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-boxes"></i>Stock Availability
      </a>
      <% } %>
    </div>

    <!-- ── HR ────────────────────────────────────── -->
    <div class="sb-section-hdr" onclick="toggleSection('hr')">
      <i class="bi bi-chevron-right sb-chevron <%= hrActive?'open':'' %>"></i>
      <i class="bi bi-people-fill"></i>HR
    </div>
    <div class="sb-section-body<%= hrActive?' show':'' %>" id="section-hr">
      <a href="/notifications" class="sb-link nav-link d-flex align-items-center <%= active==='notifications'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-bell-fill"></i><span class="flex-grow-1">Notifications</span>
        <% if (unreadCount > 0) { %><span class="badge bg-danger" style="font-size:9px"><%= unreadCount %></span><% } %>
      </a>
      <% if (hasPerm('attendance')) { %>
      <a href="/attendance" class="sb-link nav-link <%= active==='attendance'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-calendar-check-fill"></i>Attendance
      </a>
      <% } %>
      <a href="/leaves" class="sb-link nav-link <%= active==='leaves'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-calendar-x-fill"></i>My Leaves
      </a>
      <a href="/salary" class="sb-link nav-link <%= active==='salary'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-cash-coin"></i>My Salary
      </a>
      <a href="/expenses" class="sb-link nav-link <%= active==='expenses'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-receipt"></i>Expenses
      </a>
      <a href="/id-card" class="sb-link nav-link <%= active==='id-card'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-credit-card-2-front-fill"></i>ID Card
      </a>
      <a href="/profile" class="sb-link nav-link <%= active==='profile'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-person-circle"></i>My Profile
      </a>

      <% if (hasPerm('hr_admin') || isAdmin) { %>
      <div class="sb-sub-label">HR Admin</div>
      <a href="/hr/dashboard" class="sb-link nav-link <%= active==='hr'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-grid-fill"></i>HR Dashboard
      </a>
      <a href="/hr/employees" class="sb-link nav-link" onclick="closeSidebarOnMobile()">
        <i class="bi bi-person-lines-fill"></i>Employees
      </a>
      <a href="/hr/attendance" class="sb-link nav-link" onclick="closeSidebarOnMobile()">
        <i class="bi bi-calendar-week-fill"></i>Attendance Report
      </a>
      <% if (hasPerm('leave_approval') || isAdmin) { %>
      <a href="/hr/leaves" class="sb-link nav-link" onclick="closeSidebarOnMobile()">
        <i class="bi bi-check2-square"></i>Leave Approvals
      </a>
      <% } %>
      <% if (hasPerm('salary_admin') || isAdmin) { %>
      <a href="/hr/salary" class="sb-link nav-link" onclick="closeSidebarOnMobile()">
        <i class="bi bi-wallet2"></i>Salary Manager
      </a>
      <% } %>
      <% } %>

      <% if (isAdmin) { %>
      <div class="sb-sub-label">System</div>
      <a href="/users" class="sb-link nav-link <%= active==='users'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-person-gear"></i>Users
      </a>
      <a href="/settings" class="sb-link nav-link <%= active==='settings'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-sliders"></i>Settings
      </a>
      <% } %>
    </div>

  </div><!-- /scrollable -->

  <!-- User strip -->
  <hr class="border-secondary my-0">
  <div class="d-flex align-items-center gap-2 px-3 py-2">
    <div class="flex-grow-1" style="min-width:0">
      <small class="text-white-50" style="font-size:9px">Logged in as</small><br>
      <span class="fw-semibold text-truncate d-block" style="max-width:140px;font-size:13px">
        <%= user ? user.full_name || user.username : '' %>
      </span>
      <% const roleBadge = {admin:'bg-danger',manager:'bg-warning text-dark',sales:'bg-info text-dark',office:'bg-primary',hr:'bg-purple',service:'bg-secondary',staff:'bg-secondary',employee:'bg-success'}; %>
      <span class="badge <%= roleBadge[user?.role] || 'bg-secondary' %>" style="font-size:9px"><%= (user?.role||'').toUpperCase() %></span>
    </div>
    <a href="/logout" class="btn btn-sm btn-outline-light flex-shrink-0" title="Logout">
      <i class="bi bi-box-arrow-right"></i>
    </a>
  </div>
</nav>

<style>
/* Section headers */
.sb-section-hdr {
  display: flex; align-items: center; gap: 6px;
  padding: 7px 8px; margin-top: 2px;
  font-size: 10.5px; font-weight: 800; letter-spacing: 1.3px;
  color: rgba(255,255,255,0.45);
  cursor: pointer; border-radius: 6px;
  user-select: none; transition: background .15s, color .15s;
}
.sb-section-hdr:hover { background: rgba(255,255,255,0.07); color: rgba(255,255,255,0.7); }
.sb-section-hdr i { font-size: 12px; }

/* Chevron animation */
.sb-chevron { transition: transform .2s; }
.sb-chevron.open { transform: rotate(90deg); }

/* Section body */
.sb-section-body { display: none; padding-left: 4px; margin-bottom: 4px; }
.sb-section-body.show { display: block; }

/* Nav links inside sections */
.sb-link {
  display: flex; align-items: center; gap: 8px;
  padding: 5px 8px; border-radius: 6px; margin-bottom: 1px;
  font-size: 13px; color: rgba(255,255,255,0.72) !important;
  text-decoration: none; transition: background .12s, color .12s;
}
.sb-link i { font-size: 13px; width: 15px; text-align: center; flex-shrink: 0; }
.sb-link:hover { background: rgba(255,255,255,0.1) !important; color: #fff !important; }
.sb-link.active { background: rgba(255,255,255,0.15) !important; color: #fff !important; font-weight: 600; }

/* Top-level dashboard link */
.sb-top-link { font-size: 14px !important; }
.sb-top-link i { font-size: 16px; width: 18px; }
.sb-top-link:hover { background: rgba(255,255,255,0.1); }
.sb-top-link.active { background: rgba(255,255,255,0.16) !important; font-weight: 700 !important; }

/* Sub-labels inside sections */
.sb-sub-label {
  font-size: 9px; font-weight: 700; letter-spacing: 1px;
  color: rgba(255,255,255,0.35); text-transform: uppercase;
  padding: 6px 8px 3px 8px;
}

.sidebar-scroll { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.15) transparent; }
</style>

<script>
function toggleSection(id) {
  const body    = document.getElementById('section-' + id);
  const chevrons = document.querySelectorAll('.sb-section-hdr');
  // find the chevron for this section
  const allBodies = document.querySelectorAll('.sb-section-body');
  allBodies.forEach(b => {
    if (b.id === 'section-' + id) {
      const isOpen = b.classList.contains('show');
      b.classList.toggle('show', !isOpen);
      // flip the chevron inside the preceding sibling header
      const hdr = b.previousElementSibling;
      if (hdr) {
        const ch = hdr.querySelector('.sb-chevron');
        if (ch) ch.classList.toggle('open', !isOpen);
      }
    }
  });
}
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('sidebar-open');
  document.getElementById('sidebarBackdrop').classList.toggle('show');
}
function closeSidebarOnMobile() {
  if (window.innerWidth < 992) {
    document.getElementById('sidebar').classList.remove('sidebar-open');
    document.getElementById('sidebarBackdrop').classList.remove('show');
  }
}

// Universal search
const searchInput = document.getElementById('universalSearch');
const searchDropdown = document.getElementById('searchDropdown');
let searchTimeout;

if (searchInput) {
  searchInput.addEventListener('input', async (e) => {
    clearTimeout(searchTimeout);
    const query = e.target.value.trim();

    if (!query) {
      searchDropdown.classList.remove('show');
      return;
    }

    searchTimeout = setTimeout(async () => {
      try {
        const resp = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
        const results = await resp.json();

        if (!results.results || results.results.length === 0) {
          searchDropdown.innerHTML = '<div class="p-2 text-muted small text-center">No results found</div>';
          searchDropdown.classList.add('show');
          return;
        }

        let html = '';
        let currentCategory = '';

        results.results.forEach(item => {
          if (item.category !== currentCategory) {
            if (currentCategory) html += '</div>';
            html += `<div class="search-result-category">${item.category}</div>`;
            currentCategory = item.category;
          }
          html += `
            <a href="${item.link}" class="search-result-item" onclick="closeSidebarOnMobile()">
              <div class="search-result-title">${item.title}</div>
              ${item.meta ? `<div class="search-result-meta">${item.meta}</div>` : ''}
            </a>
          `;
        });

        searchDropdown.innerHTML = html;
        searchDropdown.classList.add('show');
      } catch(e) {
        searchDropdown.innerHTML = '<div class="p-2 text-danger small">Search error</div>';
        searchDropdown.classList.add('show');
      }
    }, 300);
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.search-input-wrapper')) {
      searchDropdown.classList.remove('show');
    }
  });
}
</script>
