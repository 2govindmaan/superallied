<!-- Mobile Top Bar (hidden on desktop) -->
<div class="mobile-topbar">
  <button class="hamburger-btn" onclick="toggleSidebar()" aria-label="Open menu">
    <i class="bi bi-list"></i>
  </button>
  <span class="app-title">SUPER ALLIED</span>
  <a href="/logout" class="btn btn-sm btn-outline-light ms-auto">
    <i class="bi bi-box-arrow-right"></i>
  </a>
</div>

<!-- Backdrop overlay (mobile only) -->
<div id="sidebarBackdrop" class="sidebar-backdrop" onclick="toggleSidebar()"></div>

<!-- Sidebar -->
<nav id="sidebar" class="d-flex flex-column p-3 text-white">

  <!-- Mobile close button row -->
  <div class="d-flex justify-content-between align-items-center d-lg-none mb-2 pb-2 border-bottom border-secondary">
    <span class="fw-semibold text-white-50 small text-uppercase" style="font-size:11px">Menu</span>
    <button onclick="toggleSidebar()" class="btn btn-sm text-white border-0 p-0">
      <i class="bi bi-x-lg fs-5"></i>
    </button>
  </div>

  <a href="/" class="d-flex align-items-center mb-3 text-white text-decoration-none gap-2">
    <div class="brand-logo flex-shrink-0">SA</div>
    <div>
      <div class="fw-bold lh-1">Super Allied</div>
      <small class="text-white-50" style="font-size:10px">Bull CE Dealer</small>
    </div>
  </a>
  <div class="text-center mb-3">
    <img src="/bull-logo.jpg" alt="Bull" style="height:36px;opacity:0.9;border-radius:4px;" onerror="this.style.display='none'">
  </div>
  <hr class="border-secondary mt-0">

  <ul class="nav flex-column mb-auto">
    <li class="nav-item">
      <a href="/" class="nav-link text-white <%= active==='dashboard'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-speedometer2 me-2"></i>Dashboard
      </a>
    </li>

    <!-- Lead Management -->
    <li class="nav-item">
      <a href="/leads" class="nav-link text-white <%= active==='leads'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-funnel-fill me-2"></i>Lead Management
      </a>
    </li>

    <!-- Sales / Quotations (permission-gated) -->
    <% if (hasPerm('quotations')) { %>
    <li class="nav-item">
      <a href="/quotations" class="nav-link text-white <%= active==='quotations'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-file-earmark-text me-2"></i>Quotations
      </a>
    </li>
    <% } %>
    <% if (hasPerm('customers')) { %>
    <li class="nav-item">
      <a href="/customers" class="nav-link text-white <%= active==='customers'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-people me-2"></i>Customers
      </a>
    </li>
    <% } %>
    <% if (user && user.role === 'admin') { %>
    <li class="nav-item">
      <a href="/machines" class="nav-link text-white <%= active==='machines'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-sliders me-2"></i>Machine Management
      </a>
    </li>
    <li class="nav-item">
      <a href="/calculator" class="nav-link text-white <%= active==='calculator'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-calculator me-2"></i>Profit Calculator
      </a>
    </li>
    <% } %>

    <!-- Settings + Users -->
    <li class="nav-item mt-1">
      <a href="/settings" class="nav-link text-white <%= active==='settings'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-sliders me-2"></i>Settings
      </a>
    </li>
    <% if (user && user.role === 'admin') { %>
    <li class="nav-item">
      <a href="/users" class="nav-link text-white <%= active==='users'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-person-badge me-2"></i>Users
      </a>
    </li>
    <% } %>

    <!-- HR & Personal separator -->
    <li class="nav-item mt-2">
      <div class="text-white-50 px-2 py-1" style="font-size:10px;text-transform:uppercase;letter-spacing:1px">My HR</div>
    </li>
    <li class="nav-item">
      <a href="/notifications" class="nav-link text-white <%= active==='notifications'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-bell me-2"></i>Notifications
        <% if (unreadCount > 0) { %><span class="badge bg-danger ms-1"><%= unreadCount %></span><% } %>
      </a>
    </li>
    <% if (hasPerm('attendance')) { %>
    <li class="nav-item">
      <a href="/attendance" class="nav-link text-white <%= active==='attendance'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-calendar-check me-2"></i>Attendance
      </a>
    </li>
    <% } %>
    <% if (hasPerm('field_visit')) { %>
    <li class="nav-item">
      <a href="/visits" class="nav-link text-white <%= active==='visits'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-geo-alt me-2"></i>Field Visits
      </a>
    </li>
    <% } %>
    <li class="nav-item">
      <a href="/leaves" class="nav-link text-white <%= active==='leaves'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-calendar-x me-2"></i>My Leaves
      </a>
    </li>
    <li class="nav-item">
      <a href="/salary" class="nav-link text-white <%= active==='salary'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-cash-coin me-2"></i>My Salary
      </a>
    </li>
    <li class="nav-item">
      <a href="/id-card" class="nav-link text-white <%= active==='id-card'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-credit-card-2-front me-2"></i>ID Card
      </a>
    </li>
    <li class="nav-item">
      <a href="/profile" class="nav-link text-white <%= active==='profile'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-person-circle me-2"></i>My Profile
      </a>
    </li>

    <!-- HR Admin (manager / hr role / admin) -->
    <% if (hasPerm('hr_admin') || user?.role === 'admin') { %>
    <li class="nav-item mt-2">
      <div class="text-white-50 px-2 py-1" style="font-size:10px;text-transform:uppercase;letter-spacing:1px">HR Admin</div>
    </li>
    <li class="nav-item">
      <a href="/hr/dashboard" class="nav-link text-white <%= active==='hr'?'active':'' %>" onclick="closeSidebarOnMobile()">
        <i class="bi bi-people me-2"></i>HR Dashboard
      </a>
    </li>
    <li class="nav-item">
      <a href="/hr/employees" class="nav-link text-white" onclick="closeSidebarOnMobile()">
        <i class="bi bi-person-lines-fill me-2"></i>Employees
      </a>
    </li>
    <li class="nav-item">
      <a href="/hr/attendance" class="nav-link text-white" onclick="closeSidebarOnMobile()">
        <i class="bi bi-calendar-week me-2"></i>Attendance Report
      </a>
    </li>
    <% if (hasPerm('leave_approval') || user?.role === 'admin') { %>
    <li class="nav-item">
      <a href="/hr/leaves" class="nav-link text-white" onclick="closeSidebarOnMobile()">
        <i class="bi bi-check2-square me-2"></i>Leave Approvals
      </a>
    </li>
    <% } %>
    <% if (hasPerm('salary_admin') || user?.role === 'admin') { %>
    <li class="nav-item">
      <a href="/hr/salary" class="nav-link text-white" onclick="closeSidebarOnMobile()">
        <i class="bi bi-wallet2 me-2"></i>Salary Manager
      </a>
    </li>
    <% } %>
    <% } %>
  </ul>

  <hr class="border-secondary">
  <div class="d-flex align-items-center gap-2">
    <div class="flex-grow-1" style="min-width:0">
      <small class="text-white-50" style="font-size:10px">Logged in as</small><br>
      <span class="fw-semibold text-truncate d-block" style="max-width:150px">
        <%= user ? user.full_name || user.username : '' %>
      </span>
      <% const roleBadge = {admin:'bg-danger',manager:'bg-warning text-dark',staff:'bg-primary',employee:'bg-success'}; %>
      <span class="badge <%= roleBadge[user?.role] || 'bg-secondary' %>" style="font-size:9px"><%= (user?.role||'').toUpperCase() %></span>
    </div>
    <a href="/logout" class="btn btn-sm btn-outline-light flex-shrink-0 d-none d-lg-inline-flex">
      <i class="bi bi-box-arrow-right"></i>
    </a>
  </div>
</nav>

<script>
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('sidebar-open');
  document.getElementById('sidebarBackdrop').classList.toggle('show');
}
function closeSidebarOnMobile() {
  if (window.innerWidth < 992) {
    document.getElementById('sidebar').classList.remove('sidebar-open');
    document.getElementById('sidebarBackdrop').classList.remove('show');
  }
}
</script>
