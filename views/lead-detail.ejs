<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'leads', user }) %>
<div class="main-content">

  <!-- Header -->
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
      <h4 class="mb-0 fw-bold"><%= lead.lead_number %></h4>
      <small class="text-muted">Created <%= new Date(lead.created_at).toLocaleDateString('en-IN') %> by <%= lead.creator_name || 'Unknown' %></small>
    </div>
    <div class="d-flex gap-2">
      <a href="/leads/<%= lead.id %>/edit" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
      <a href="/leads" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible py-2"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible py-2"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <!-- Status banner -->
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
      <div class="row align-items-center">
        <div class="col-md-8">
          <h5 class="mb-1 fw-bold"><%= lead.customer_name %>
            <span class="badge <%= lead.customer_category==='RTB'?'bg-success':'bg-primary' %> ms-2" style="font-size:11px"><%= lead.customer_category %></span>
          </h5>
          <div class="text-muted"><i class="bi bi-telephone me-1"></i><%= lead.customer_phone || '—' %>
            <% if(lead.model_required) { %> &nbsp;|&nbsp; <i class="bi bi-gear me-1"></i><%= lead.model_required %><% } %>
            <% if(lead.dealer_location) { %> &nbsp;|&nbsp; <i class="bi bi-geo-alt me-1"></i><%= lead.dealer_location %><%= lead.state ? ', '+lead.state : '' %><% } %>
          </div>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
          <% if(lead.status === 'won') { %>
            <span class="badge bg-success fs-6 px-3 py-2"><i class="bi bi-trophy me-1"></i>WON</span>
          <% } else if(lead.status === 'lost') { %>
            <span class="badge bg-danger fs-6 px-3 py-2"><i class="bi bi-x-circle me-1"></i>LOST</span>
          <% } else { %>
            <span class="badge bg-primary fs-6 px-3 py-2"><i class="bi bi-activity me-1"></i>ACTIVE — Stage <%= lead.current_stage %></span>
          <% } %>
          <div class="mt-2">
            <% if(lead.status !== 'won') { %>
            <button class="btn btn-sm btn-success me-1" onclick="changeStatus('won')"><i class="bi bi-trophy me-1"></i>Mark Won</button>
            <% } %>
            <% if(lead.status !== 'lost') { %>
            <button class="btn btn-sm btn-danger" onclick="changeStatus('lost')"><i class="bi bi-x-circle me-1"></i>Mark Lost</button>
            <% } %>
            <% if(lead.status !== 'active') { %>
            <button class="btn btn-sm btn-outline-secondary" onclick="changeStatus('active')"><i class="bi bi-arrow-repeat me-1"></i>Reopen</button>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Stage progress -->
      <% if(lead.status === 'active') { %>
      <div class="mt-3">
        <div class="d-flex justify-content-between mb-1">
          <% for(let s=1;s<=5;s++) { %>
          <div class="text-center" style="flex:1">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                 style="width:32px;height:32px;font-size:12px;
                        background:<%= lead.current_stage >= s ? '#dc3545' : '#e9ecef' %>;
                        color:<%= lead.current_stage >= s ? '#fff' : '#6c757d' %>">
              <%= s %>
            </div>
            <div style="font-size:10px;margin-top:2px;color:<%= lead.current_stage >= s ? '#dc3545' : '#6c757d' %>">
              <%= STAGES[s].label.split(' ')[0] %>
            </div>
          </div>
          <% if(s<5) { %>
          <div style="flex:0.5;margin-top:15px">
            <div style="height:2px;background:<%= lead.current_stage > s ? '#dc3545' : '#e9ecef' %>"></div>
          </div>
          <% } %>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
  </div>

  <div class="row g-3">

    <!-- Left column -->
    <div class="col-md-6">

      <!-- Basic Info -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header py-2 bg-light"><span class="fw-semibold small">Basic Information</span></div>
        <div class="card-body">
          <table class="table table-sm mb-0">
            <tr><td class="text-muted small" width="45%">SH / RM</td><td><%= lead.sh_name || '—' %></td></tr>
            <tr><td class="text-muted small">Team Member</td><td><%= lead.team_member || '—' %></td></tr>
            <tr><td class="text-muted small">State</td><td><%= lead.state || '—' %></td></tr>
            <tr><td class="text-muted small">Dealer / Location</td><td><%= lead.dealer_location || '—' %></td></tr>
            <tr><td class="text-muted small">District</td><td><%= lead.district || '—' %></td></tr>
            <tr><td class="text-muted small">Tehsil / City</td><td><%= [lead.tehsil, lead.village_city].filter(Boolean).join(' / ') || '—' %></td></tr>
            <tr><td class="text-muted small">Who Visited</td><td><%= lead.who_visited || '—' %></td></tr>
            <tr><td class="text-muted small">Margin Money</td><td><%= lead.margin_money_available || '—' %></td></tr>
          </table>
        </div>
      </div>

      <!-- Visit dates -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header py-2 bg-light"><span class="fw-semibold small">Visit History</span></div>
        <div class="card-body">
          <div class="row g-2 text-center">
            <% ['visit1_date','visit2_date','visit3_date'].forEach((v,i) => { %>
            <div class="col-4">
              <div class="border rounded p-2 <%= lead[v] ? 'border-success' : 'border-dashed' %>">
                <div class="small text-muted">Visit <%= i+1 %></div>
                <div class="fw-semibold small <%= lead[v] ? 'text-success' : 'text-muted' %>">
                  <%= lead[v] ? new Date(lead[v]).toLocaleDateString('en-IN') : 'Pending' %>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
          <div class="mt-2 small">
            <span class="me-3"><i class="bi bi-display <%= lead.demo_seen?'text-success':'text-muted' %> me-1"></i>Demo: <%= lead.demo_seen ? 'Yes' : 'No' %></span>
            <span><i class="bi bi-hand-thumbs-up <%= lead.customer_interested?'text-success':'text-muted' %> me-1"></i>Interested: <%= lead.customer_interested ? 'Yes' : 'No' %></span>
          </div>
          <% if(lead.expected_purchase_date) { %>
          <div class="mt-1 small"><i class="bi bi-calendar-event me-1 text-warning"></i>Expected: <%= new Date(lead.expected_purchase_date).toLocaleDateString('en-IN') %>
            <% if(new Date(lead.expected_purchase_date) < new Date() && lead.status === 'active') { %><span class="badge bg-danger ms-1">Overdue</span><% } %>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Assets -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header py-2 bg-light"><span class="fw-semibold small">Customer Assets & Income</span></div>
        <div class="card-body">
          <table class="table table-sm mb-0">
            <tr><td class="text-muted small" width="45%">Existing Machine</td><td><%= lead.customer_assets || '—' %></td></tr>
            <tr><td class="text-muted small">Other Income</td><td><%= lead.other_income || '—' %></td></tr>
            <tr><td class="text-muted small">Work Order</td><td><%= lead.work_order ? 'Yes' : 'No' %></td></tr>
          </table>
          <% if(lead.remarks) { %>
          <div class="mt-2 p-2 bg-light rounded small"><%= lead.remarks %></div>
          <% } %>
        </div>
      </div>

    </div>

    <!-- Right column — Stages -->
    <div class="col-md-6">

      <!-- Stage 1 -->
      <div class="card border-0 shadow-sm mb-3 <%= lead.current_stage >= 1 ? '' : 'opacity-50' %>">
        <div class="card-header py-2 d-flex align-items-center gap-2"
             style="background:<%= lead.current_stage >= 1 ? '#e3f2fd' : '#f8f9fa' %>">
          <span class="badge rounded-circle bg-primary">1</span>
          <span class="fw-semibold small">Documentation & CIBIL</span>
          <% if(lead.docs_submitted && lead.guarantor_docs_submitted) { %>
          <span class="ms-auto badge bg-success">Complete</span>
          <% } %>
        </div>
        <div class="card-body">
          <div class="row g-2 small">
            <div class="col-6"><i class="bi bi-<%= lead.docs_submitted?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>Customer Docs</div>
            <div class="col-6"><i class="bi bi-<%= lead.guarantor_docs_submitted?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>Guarantor Docs</div>
            <% if(lead.guarantor_name) { %><div class="col-12 text-muted">Guarantor: <strong><%= lead.guarantor_name %></strong></div><% } %>
            <div class="col-6 text-muted">Cust. CIBIL: <strong><%= lead.cibil_customer || '—' %></strong></div>
            <div class="col-6 text-muted">Guarantor CIBIL: <strong><%= lead.cibil_guarantor || '—' %></strong></div>
          </div>
        </div>
      </div>

      <!-- Stage 2 -->
      <div class="card border-0 shadow-sm mb-3 <%= lead.current_stage >= 2 ? '' : 'opacity-50' %>">
        <div class="card-header py-2 d-flex align-items-center gap-2"
             style="background:<%= lead.current_stage >= 2 ? '#e0f7fa' : '#f8f9fa' %>">
          <span class="badge rounded-circle bg-info">2</span>
          <span class="fw-semibold small">Finance Investigation (FI)</span>
          <% if(lead.fi_done && lead.fi_result === 'Positive') { %>
          <span class="ms-auto badge bg-success">Positive</span>
          <% } else if(lead.fi_result === 'Negative') { %>
          <span class="ms-auto badge bg-danger">Negative</span>
          <% } %>
        </div>
        <div class="card-body">
          <div class="row g-2 small">
            <div class="col-6"><i class="bi bi-<%= lead.fi_done?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>FI Done</div>
            <div class="col-6 text-muted">Result: <strong><%= lead.fi_result || '—' %></strong></div>
            <div class="col-6 text-muted">Financier: <strong><%= lead.financier_name || '—' %></strong></div>
            <div class="col-6 text-muted">Executive: <strong><%= lead.financier_exec_name || '—' %></strong></div>
            <% if(lead.exec_contact) { %><div class="col-12 text-muted">Contact: <strong><%= lead.exec_contact %></strong></div><% } %>
          </div>
        </div>
      </div>

      <!-- Stage 3 -->
      <div class="card border-0 shadow-sm mb-3 <%= lead.current_stage >= 3 ? '' : 'opacity-50' %>">
        <div class="card-header py-2 d-flex align-items-center gap-2"
             style="background:<%= lead.current_stage >= 3 ? '#fff8e1' : '#f8f9fa' %>">
          <span class="badge rounded-circle bg-warning text-dark">3</span>
          <span class="fw-semibold small">Loan Processing</span>
          <% if(lead.loan_sanctioned) { %><span class="ms-auto badge bg-success">Sanctioned</span><% } %>
        </div>
        <div class="card-body">
          <div class="row g-2 small">
            <div class="col-6 text-muted">Required: <strong><%= lead.loan_amount_required || '—' %></strong></div>
            <div class="col-6 text-muted">Sanctioned: <strong><%= lead.loan_amount || '—' %></strong></div>
            <div class="col-4"><i class="bi bi-<%= lead.credit_query_resolved?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>Credit Query</div>
            <div class="col-4"><i class="bi bi-<%= lead.credit_approval_raised?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>Approval Raised</div>
            <div class="col-4"><i class="bi bi-<%= lead.loan_sanctioned?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>Sanctioned</div>
          </div>
        </div>
      </div>

      <!-- Stage 4 -->
      <div class="card border-0 shadow-sm mb-3 <%= lead.current_stage >= 4 ? '' : 'opacity-50' %>">
        <div class="card-header py-2 d-flex align-items-center gap-2"
             style="background:<%= lead.current_stage >= 4 ? '#fff3e0' : '#f8f9fa' %>">
          <span class="badge rounded-circle" style="background:#e65100">4</span>
          <span class="fw-semibold small">Delivery Order (DO)</span>
          <% if(lead.do_issued) { %><span class="ms-auto badge bg-success">DO Issued</span><% } else if(lead.do_expected_date) { %><span class="ms-auto badge bg-warning text-dark">Expected <%= new Date(lead.do_expected_date).toLocaleDateString('en-IN') %></span><% } %>
        </div>
        <div class="card-body">
          <div class="row g-2 small">
            <div class="col-6 text-muted">Margin Money: <strong><%= lead.margin_money_status || '—' %></strong></div>
            <div class="col-6"></div>
            <div class="col-4"><i class="bi bi-<%= lead.do_issued?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>DO Issued</div>
            <div class="col-4"><i class="bi bi-<%= lead.billing_done?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>Billing</div>
            <div class="col-4"><i class="bi bi-<%= lead.invoice_done?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>Invoice</div>
            <div class="col-4"><i class="bi bi-<%= lead.insurance_done?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>Insurance</div>
            <div class="col-4"><i class="bi bi-<%= lead.form_21_22?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>Form 21/22</div>
          </div>
        </div>
      </div>

      <!-- Stage 5 -->
      <div class="card border-0 shadow-sm mb-3 <%= lead.current_stage >= 5 ? '' : 'opacity-50' %>">
        <div class="card-header py-2 d-flex align-items-center gap-2"
             style="background:<%= lead.current_stage >= 5 ? '#e8f5e9' : '#f8f9fa' %>">
          <span class="badge rounded-circle bg-success">5</span>
          <span class="fw-semibold small">Post Delivery</span>
          <% if(lead.rc_submitted && lead.ltt_receipt && lead.margin_money_receipt) { %><span class="ms-auto badge bg-success">Complete</span><% } %>
        </div>
        <div class="card-body">
          <div class="row g-2 small">
            <div class="col-4"><i class="bi bi-<%= lead.margin_money_receipt?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>MM Receipt</div>
            <div class="col-4"><i class="bi bi-<%= lead.ltt_receipt?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>LTT Receipt</div>
            <div class="col-4"><i class="bi bi-<%= lead.rc_submitted?'check-circle-fill text-success':'x-circle text-muted' %> me-1"></i>RC Submitted</div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Delete button (admin) -->
  <% if(user.role === 'admin') { %>
  <div class="mt-2">
    <form method="post" action="/leads/<%= lead.id %>/delete" onsubmit="return confirm('Delete this lead permanently?')">
      <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete Lead</button>
    </form>
  </div>
  <% } %>
</div>

<script>
async function changeStatus(status) {
  const labels = { won: 'Mark as WON?', lost: 'Mark as LOST?', active: 'Reopen this lead?' };
  if (!confirm(labels[status] || 'Confirm?')) return;
  const r = await fetch('/leads/<%= lead.id %>/status', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ status })
  });
  const j = await r.json();
  if (j.ok) location.reload();
  else alert(j.error || 'Error');
}
</script>
