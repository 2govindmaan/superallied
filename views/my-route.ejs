<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'route', user }) %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-map me-2 text-danger"></i>My Route — Today</h4>
    <small class="text-muted"><%= today %></small>
  </div>

  <% const allPoints = []; %>
  <% if (att?.check_in_lat) allPoints.push({ lat: att.check_in_lat, lng: att.check_in_lng, label: 'Check In', type: 'checkin', time: att.check_in_time }); %>
  <% visits.forEach(v => { if(v.lat) allPoints.push({ lat: v.lat, lng: v.lng, label: v.customer_name + (v.purpose ? ' — '+v.purpose : ''), type: 'visit', time: v.visit_time }); }); %>
  <% if (att?.check_out_lat) allPoints.push({ lat: att.check_out_lat, lng: att.check_out_lng, label: 'Check Out', type: 'checkout', time: att.check_out_time }); %>

  <!-- Today's tasks (from attendance + planned visits) -->
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white fw-semibold small">Today's Tasks</div>
    <div class="list-group list-group-flush">
      <div class="list-group-item d-flex align-items-center gap-2 py-2">
        <i class="bi <%= att?.check_in_time ? 'bi-check-circle-fill text-success' : 'bi-circle text-muted' %>"></i>
        <span class="small"><%= att?.check_in_time ? 'Checked in at ' + new Date(att.check_in_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) : 'Not checked in yet' %></span>
      </div>
      <% if (!visits.length) { %>
      <div class="list-group-item py-2"><span class="small text-muted">No site visits logged yet today.</span></div>
      <% } %>
      <% visits.forEach(v => { %>
      <div class="list-group-item d-flex align-items-center gap-2 py-2">
        <i class="bi bi-geo-alt-fill text-primary"></i>
        <span class="small"><%= v.customer_name %><% if (v.purpose) { %> — <span class="text-muted"><%= v.purpose %></span><% } %></span>
      </div>
      <% }) %>
      <div class="list-group-item d-flex align-items-center gap-2 py-2">
        <i class="bi <%= att?.check_out_time ? 'bi-check-circle-fill text-success' : 'bi-circle text-muted' %>"></i>
        <span class="small"><%= att?.check_out_time ? 'Checked out at ' + new Date(att.check_out_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) : 'Not checked out yet' %></span>
      </div>
    </div>
  </div>

  <div id="routeMap" style="height: 420px; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.1)"></div>
  <div id="mapStatus" class="small text-muted mt-2"><i class="bi bi-geo-alt me-1"></i>Getting your current location…</div>

  <% if (allPoints.length > 0) { %>
  <div class="card border-0 shadow-sm mt-3">
    <div class="card-header bg-white fw-semibold small">Location Timeline</div>
    <div class="list-group list-group-flush">
      <% allPoints.forEach((p, i) => { %>
      <div class="list-group-item py-2">
        <div class="d-flex gap-2 align-items-center">
          <span class="badge <%= p.type==='checkin'?'bg-success':p.type==='checkout'?'bg-secondary':'bg-primary' %>">
            <%= i+1 %>
          </span>
          <div>
            <div class="fw-semibold small"><%= p.label %></div>
            <small class="text-muted"><%= new Date(p.time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></small>
          </div>
          <a href="https://maps.google.com/?q=<%= p.lat %>,<%= p.lng %>" target="_blank" class="ms-auto btn btn-sm btn-outline-secondary py-0">
            <i class="bi bi-geo-alt"></i>
          </a>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const pts = <%- JSON.stringify(allPoints) %>;
const map = L.map('routeMap');
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: '© OpenStreetMap contributors', maxZoom: 18
}).addTo(map);

const colors = { checkin:'green', visit:'blue', checkout:'gray' };
const bounds = [];
pts.forEach(p => {
  L.circleMarker([p.lat, p.lng], {
    radius: 10, color: colors[p.type]||'blue', fillColor: colors[p.type]||'blue', fillOpacity: 0.8
  }).addTo(map).bindPopup(`<b>${p.label}</b><br>${new Date(p.time).toLocaleTimeString()}`);
  bounds.push([p.lat, p.lng]);
});
if (bounds.length > 1) L.polyline(bounds, { color: '#cc0000', weight: 3, opacity: 0.7, dashArray: '6,4' }).addTo(map);

// Start the map centred on the device's current GPS position, then fit to
// include today's recorded points (check-in/visits/check-out) too.
function finishMap() {
  if (bounds.length > 1) map.fitBounds(bounds, { padding: [30, 30] });
  else if (bounds.length === 1) map.setView(bounds[0], 14);
  else map.setView([20.5937, 78.9629], 5); // fallback: India, zoomed out
  document.getElementById('mapStatus').innerHTML = pts.length
    ? `<i class="bi bi-geo-alt-fill text-success me-1"></i>Showing ${pts.length} location${pts.length===1?'':'s'} from today.`
    : `<i class="bi bi-info-circle me-1"></i>No check-in/visit locations recorded yet today.`;
}

if (navigator.geolocation) {
  navigator.geolocation.getCurrentPosition(pos => {
    const here = [pos.coords.latitude, pos.coords.longitude];
    L.marker(here, {
      icon: L.divIcon({ className: '', html: '<div style="width:16px;height:16px;border-radius:50%;background:#0d6efd;border:3px solid #fff;box-shadow:0 0 0 2px #0d6efd"></div>' })
    }).addTo(map).bindPopup('You are here now');
    map.setView(here, 14);
    bounds.push(here);
    finishMap();
  }, () => {
    document.getElementById('mapStatus').innerHTML = '<i class="bi bi-exclamation-triangle text-warning me-1"></i>Location permission denied — showing today\'s recorded points only.';
    finishMap();
  }, { enableHighAccuracy: true, timeout: 8000 });
} else {
  finishMap();
}
</script>
</body></html>
