<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'machines', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-cash-coin me-2 text-danger"></i>Purchase Price Management</h4>
    <a href="/machines" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Machine List</a>
  </div>

  <div class="alert alert-info mb-3">
    <i class="bi bi-info-circle me-2"></i>
    <strong>Purchase Price (Cost Price)</strong> — The cost at which you purchase the machine from the manufacturer. Used for profit margin calculation.
  </div>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 35%">Machine Model</th>
            <th style="width: 15%">Series</th>
            <th style="width: 20%">MRP (Selling Price)</th>
            <th style="width: 20%">Purchase Price</th>
            <th style="width: 10%">Profit Margin</th>
          </tr>
        </thead>
        <tbody>
          <% machines.forEach(m => {
            const margin = m.purchase_price > 0 ? Math.round(((m.basic_price - m.purchase_price) / m.basic_price) * 100) : 0;
            const marginColor = margin > 30 ? 'text-success' : margin > 20 ? 'text-warning' : margin > 0 ? 'text-danger' : 'text-secondary';
          %>
          <tr>
            <td class="fw-semibold"><%= m.display_name %></td>
            <td><small class="text-muted"><%= m.model_series %></small></td>
            <td class="fw-bold">₹<%= m.basic_price.toLocaleString('en-IN') %></td>
            <td>
              <div class="input-group input-group-sm" style="max-width: 140px">
                <span class="input-group-text">₹</span>
                <input type="number" class="form-control" value="<%= m.purchase_price %>"
                       min="0" step="100" data-machine-id="<%= m.id %>" data-selling="<%= m.basic_price %>"
                       onchange="updatePrice(this)" placeholder="0">
              </div>
            </td>
            <td>
              <span class="badge <%= marginColor %> fs-7" data-margin-id="<%= m.id %>">
                <%= margin > 0 ? margin + '%' : '—' %>
              </span>
            </td>
          </tr>
          <% }) %>
          <% if (!machines.length) { %>
          <tr><td colspan="5" class="text-center text-muted py-4">No machines found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-4 p-3 bg-light rounded">
    <h6 class="fw-bold mb-2"><i class="bi bi-calculator me-1"></i>Profit Margin Formula</h6>
    <div class="text-muted small">
      Profit Margin % = ((Selling Price - Purchase Price) / Selling Price) × 100
      <br>
      <strong class="text-dark">Example:</strong> If Purchase Price = ₹30,00,000 and Selling Price = ₹40,00,000
      <br>
      Profit = 40,00,000 - 30,00,000 = ₹10,00,000 (25% margin)
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
async function updatePrice(input) {
  const machineId = input.getAttribute('data-machine-id');
  const sellingPrice = parseFloat(input.getAttribute('data-selling'));
  const purchasePrice = parseFloat(input.value) || 0;

  if (purchasePrice < 0 || purchasePrice > sellingPrice) {
    alert('Purchase price must be between 0 and selling price (₹' + sellingPrice.toLocaleString('en-IN') + ')');
    input.value = input.defaultValue;
    return;
  }

  try {
    const resp = await fetch(`/machines/${machineId}/price`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ purchase_price: purchasePrice })
    }).then(r => r.json());

    if (resp.ok) {
      // Update margin display
      const margin = purchasePrice > 0 ? Math.round(((sellingPrice - purchasePrice) / sellingPrice) * 100) : 0;
      const marginColor = margin > 30 ? 'text-success' : margin > 20 ? 'text-warning' : margin > 0 ? 'text-danger' : 'text-secondary';

      const marginBadge = document.querySelector(`[data-margin-id="${machineId}"]`);
      if (marginBadge) {
        marginBadge.className = `badge ${marginColor} fs-7`;
        marginBadge.textContent = margin > 0 ? margin + '%' : '—';
      }

      // Visual feedback
      input.classList.add('is-valid');
      setTimeout(() => input.classList.remove('is-valid'), 2000);
    } else {
      alert('Error: ' + resp.error);
      input.value = input.defaultValue;
    }
  } catch(e) {
    alert('Network error: ' + e.message);
    input.value = input.defaultValue;
  }
}
</script>
</body></html>
