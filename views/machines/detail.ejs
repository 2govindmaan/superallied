<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'machines', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-sliders me-2 text-danger"></i><%= machine.display_name %></h4>
    <a href="/machines" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
  </div>

  <div class="row g-4">
    <!-- Machine Details -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light fw-semibold">Machine Details</div>
        <div class="card-body">
          <dl class="row mb-0 small">
            <dt class="col-5 text-muted">Model Code</dt><dd class="col-7 font-monospace"><%= machine.model_code %></dd>
            <dt class="col-5 text-muted">Series</dt><dd class="col-7"><%= machine.model_series %></dd>
            <dt class="col-5 text-muted">Basic Price</dt><dd class="col-7 fw-bold">₹<%= machine.basic_price.toLocaleString('en-IN') %></dd>
            <dt class="col-5 text-muted">Engine</dt><dd class="col-7"><%= machine.engine %></dd>
            <dt class="col-5 text-muted">Transmission</dt><dd class="col-7"><%= machine.transmission %></dd>
            <dt class="col-5 text-muted">Rear Axle</dt><dd class="col-7"><%= machine.rear_axle %></dd>
            <dt class="col-5 text-muted">Pump</dt><dd class="col-7"><%= machine.pump %></dd>
            <dt class="col-5 text-muted">Front Tyre</dt><dd class="col-7"><%= machine.front_tyre %></dd>
            <dt class="col-5 text-muted">Rear Tyre</dt><dd class="col-7"><%= machine.rear_tyre %></dd>
            <dt class="col-5 text-muted">Battery</dt><dd class="col-7"><%= machine.battery %></dd>
            <dt class="col-5 text-muted">Weight</dt><dd class="col-7"><%= machine.weight %></dd>
            <dt class="col-5 text-muted">Bucket</dt><dd class="col-7"><%= machine.bucket %></dd>
          </dl>
          <div class="mt-3 d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm" onclick="editMachine()"><i class="bi bi-pencil me-1"></i>Edit</button>
            <button class="btn btn-outline-danger btn-sm" onclick="deleteMachine()"><i class="bi bi-trash me-1"></i>Delete</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Machine Specifications -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
          <span class="fw-semibold">Specifications (<%= specs.length %>)</span>
          <button class="btn btn-sm btn-success" onclick="openAddSpec()"><i class="bi bi-plus-lg"></i>Add Spec</button>
        </div>
        <div class="card-body" style="max-height: 600px; overflow-y: auto;">
          <% if (specs.length > 0) { %>
            <div class="list-group">
              <% specs.forEach((s, idx) => { %>
              <div class="list-group-item py-2 px-3">
                <div class="d-flex justify-content-between align-items-start gap-2">
                  <div class="flex-grow-1">
                    <div class="fw-semibold small text-danger"><%= s.spec_name %></div>
                    <div class="text-muted small"><%= s.spec_value %></div>
                  </div>
                  <button class="btn btn-sm btn-outline-danger" onclick="deleteSpec(<%= s.id %>)" title="Delete">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-center text-muted py-4">No specifications added yet.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Spec Modal -->
<div class="modal fade" id="addSpecModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title fw-bold">Add Specification</h5></div>
      <div class="modal-body">
        <form id="addSpecForm">
          <div class="mb-3">
            <label class="form-label fw-semibold">Spec Name <span class="text-danger">*</span></label>
            <input type="text" name="spec_name" class="form-control" required placeholder="e.g. Horsepower, Fuel Capacity">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Spec Value <span class="text-danger">*</span></label>
            <input type="text" name="spec_value" class="form-control" required placeholder="e.g. 75 HP, 60 Liters">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Display Order</label>
            <input type="number" name="display_order" class="form-control" value="0">
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" onclick="closeAddSpec()">Cancel</button>
        <button type="button" class="btn btn-success" onclick="saveSpec()"><i class="bi bi-check-lg me-1"></i>Add Spec</button>
      </div>
    </div>
  </div>
</div>

<!-- Edit Machine Modal -->
<div class="modal fade" id="editMachineModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title fw-bold">Edit Machine</h5></div>
      <div class="modal-body">
        <form id="editMachineForm">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Display Name</label>
              <input type="text" name="display_name" class="form-control" value="<%= machine.display_name %>">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Model Series</label>
              <input type="text" name="model_series" class="form-control" value="<%= machine.model_series %>">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Basic Price</label>
              <input type="number" name="basic_price" class="form-control" value="<%= machine.basic_price %>">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Engine</label>
              <input type="text" name="engine" class="form-control" value="<%= machine.engine %>">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Transmission</label>
              <input type="text" name="transmission" class="form-control" value="<%= machine.transmission %>">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Rear Axle</label>
              <input type="text" name="rear_axle" class="form-control" value="<%= machine.rear_axle %>">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Pump</label>
              <input type="text" name="pump" class="form-control" value="<%= machine.pump %>">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Front Tyre</label>
              <input type="text" name="front_tyre" class="form-control" value="<%= machine.front_tyre %>">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Rear Tyre</label>
              <input type="text" name="rear_tyre" class="form-control" value="<%= machine.rear_tyre %>">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Battery</label>
              <input type="text" name="battery" class="form-control" value="<%= machine.battery %>">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Weight</label>
              <input type="text" name="weight" class="form-control" value="<%= machine.weight %>">
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Bucket</label>
              <input type="text" name="bucket" class="form-control" value="<%= machine.bucket %>">
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Warranty</label>
              <input type="text" name="warranty" class="form-control" value="<%= machine.warranty %>">
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" onclick="closeEditMachine()">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="updateMachine()"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
const machineId = <%= machine.id %>;

function openAddSpec() {
  document.getElementById('addSpecForm').reset();
  new bootstrap.Modal(document.getElementById('addSpecModal')).show();
}

function closeAddSpec() {
  bootstrap.Modal.getInstance(document.getElementById('addSpecModal')).hide();
}

async function saveSpec() {
  const form = document.getElementById('addSpecForm');
  const data = new FormData(form);
  const obj = Object.fromEntries(data);

  const resp = await fetch(`/machines/${machineId}/specs`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(obj)
  }).then(r => r.json());

  if (resp.ok) {
    closeAddSpec();
    location.reload();
  } else {
    alert('Error: ' + resp.error);
  }
}

async function deleteSpec(specId) {
  if (!confirm('Delete this specification?')) return;

  const resp = await fetch(`/machines/${machineId}/specs/${specId}`, {
    method: 'DELETE'
  }).then(r => r.json());

  if (resp.ok) {
    location.reload();
  } else {
    alert('Error: ' + resp.error);
  }
}

function editMachine() {
  new bootstrap.Modal(document.getElementById('editMachineModal')).show();
}

function closeEditMachine() {
  bootstrap.Modal.getInstance(document.getElementById('editMachineModal')).hide();
}

async function updateMachine() {
  const form = document.getElementById('editMachineForm');
  const data = new FormData(form);
  const obj = Object.fromEntries(data);

  const resp = await fetch(`/machines/${machineId}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(obj)
  }).then(r => r.json());

  if (resp.ok) {
    closeEditMachine();
    location.reload();
  } else {
    alert('Error: ' + resp.error);
  }
}

function deleteMachine() {
  if (!confirm('Delete this machine and all its specifications?')) return;
  fetch(`/machines/${machineId}`, { method: 'DELETE' }).then(r => r.json()).then(resp => {
    if (resp.ok) {
      window.location = '/machines';
    } else {
      alert('Error: ' + resp.error);
    }
  });
}
</script>
</body></html>
