<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'sold-machines', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-hdd-rack me-2 text-primary"></i>Sold Machines Registry</h4>
    <div class="d-flex gap-2">
      <button class="btn btn-outline-success btn-sm" onclick="document.getElementById('importModal').style.display='flex'" title="Import Excel">
        <i class="bi bi-upload me-1"></i>Import
      </button>
      <a href="/sold-machines/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Register Machine</a>
    </div>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
      <form method="get" class="d-flex gap-2">
        <input name="q" value="<%= q %>" class="form-control" placeholder="Search by Machine No, Customer, Chassis, Mobile…" style="max-width:400px">
        <button class="btn btn-outline-secondary">Search</button>
        <% if (q) { %><a href="/sold-machines" class="btn btn-outline-secondary">Clear</a><% } %>
      </form>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold">Machines (<%= rows.length %>)</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Machine No</th>
            <th>Customer</th>
            <th>Model</th>
            <th>Mobile</th>
            <th>Date of Sale</th>
            <th>Quotations</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (rows.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-4">No machines found. <a href="/sold-machines/new">Register the first one.</a></td></tr>
          <% } %>
          <% rows.forEach(m => { %>
          <tr>
            <td><a href="/sold-machines/<%= m.id %>" class="fw-semibold text-decoration-none"><%= m.machine_no %></a></td>
            <td>
              <div class="fw-semibold"><%= m.customer_name %></div>
              <small class="text-muted"><%= m.place_of_supply || m.customer_address?.substring(0,40) %></small>
            </td>
            <td><small><%= m.model || '—' %></small></td>
            <td>
              <% if (m.mobile_1) { %>
              <a href="tel:<%= m.mobile_1 %>" class="text-decoration-none"><i class="bi bi-phone me-1 text-success"></i><%= m.mobile_1 %></a>
              <% } else { %>—<% } %>
            </td>
            <td><small><%= m.date_of_sale ? new Date(m.date_of_sale).toLocaleDateString('en-IN') : '—' %></small></td>
            <td>
              <span class="badge bg-primary-subtle text-primary"><%= m.quotation_count %></span>
            </td>
            <td>
              <div class="d-flex gap-1">
                <a href="/spare-quotations/new?machine_no=<%= encodeURIComponent(m.machine_no) %>" class="btn btn-sm btn-success" title="New Spare Quotation">
                  <i class="bi bi-file-plus"></i>
                </a>
                <a href="/sold-machines/<%= m.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Import Modal -->
<div id="importModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center">
  <div class="card border-0 shadow-lg" style="width:500px;max-width:95vw">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-semibold">Import Machines from Excel</span>
      <button class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('importModal').style.display='none'">✕</button>
    </div>
    <div class="card-body">
      <p class="small text-muted">Excel columns: <strong>Machine No, Customer Name, Chassis Number, Engine Number, Model, Customer Address, Place of Supply, Contact Person, Mobile 1, Mobile 2, Finance Type, Financier, Registration No, GST Number, PAN Number, Dealer, Date of Sale</strong></p>
      <input type="file" id="importFile" accept=".xlsx,.xls" class="form-control mb-3">
      <div id="importResult" class="d-none alert"></div>
    </div>
    <div class="card-footer d-flex gap-2 justify-content-end">
      <button class="btn btn-outline-secondary" onclick="document.getElementById('importModal').style.display='none'">Cancel</button>
      <button class="btn btn-success" onclick="doImportMachines()"><i class="bi bi-upload me-1"></i>Import</button>
    </div>
  </div>
</div>

<script>
async function doImportMachines() {
  const file = document.getElementById('importFile').files[0];
  if (!file) return alert('Select a file first.');
  const reader = new FileReader();
  reader.onload = async e => {
    const base64 = btoa(String.fromCharCode(...new Uint8Array(e.target.result)));
    const r = await fetch('/sold-machines/import/excel', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ data: base64 })
    });
    const j = await r.json();
    const div = document.getElementById('importResult');
    div.classList.remove('d-none','alert-success','alert-danger');
    if (j.ok) {
      div.classList.add('alert-success');
      div.innerHTML = `Imported: <strong>${j.inserted}</strong> new, <strong>${j.skipped}</strong> skipped.` +
        (j.errors?.length ? `<br>Errors: ${j.errors.slice(0,3).join('; ')}` : '');
      setTimeout(() => location.reload(), 2000);
    } else {
      div.classList.add('alert-danger');
      div.textContent = j.error;
    }
    div.classList.add('d-block');
  };
  reader.readAsArrayBuffer(file);
}
</script>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
