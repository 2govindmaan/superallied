<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'sold-machines', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><%= machine ? 'Edit Machine' : 'Register Sold Machine' %></h4>
    <a href="<%= machine ? '/sold-machines/' + machine.id : '/sold-machines' %>" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i>Back
    </a>
  </div>

  <% if (flash.error) { %><div class="alert alert-danger"><%= flash.error %></div><% } %>

  <form method="post" action="<%= machine ? '/sold-machines/' + machine.id + '/update' : '/sold-machines' %>">
    <div class="row g-3">

      <!-- Machine Details -->
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-primary text-white fw-semibold">
            <i class="bi bi-hdd-rack me-2"></i>Machine Details
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-md-3">
                <label class="form-label fw-semibold">Machine No <span class="text-danger">*</span></label>
                <input name="machine_no" value="<%= machine?.machine_no||'' %>" class="form-control"
                  <%= machine ? 'readonly' : 'required' %> placeholder="e.g. BHL2025001">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-semibold">Chassis Number</label>
                <input name="chassis_number" value="<%= machine?.chassis_number||'' %>" class="form-control">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-semibold">Engine Number</label>
                <input name="engine_number" value="<%= machine?.engine_number||'' %>" class="form-control">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-semibold">Model</label>
                <input name="model" value="<%= machine?.model||'' %>" class="form-control" placeholder="e.g. Bull SD76 BHL 2WD">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-semibold">Registration No</label>
                <input name="registration_no" value="<%= machine?.registration_no||'' %>" class="form-control">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-semibold">Date of Sale</label>
                <input type="date" name="date_of_sale" value="<%= machine?.date_of_sale||'' %>" class="form-control">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-semibold">Dealer</label>
                <input name="dealer" value="<%= machine?.dealer||'' %>" class="form-control">
              </div>
              <div class="col-md-3">
                <label class="form-label fw-semibold">Finance Type</label>
                <select name="finance_type" class="form-select">
                  <option value="Cash" <%= (machine?.finance_type||'Cash')==='Cash'?'selected':'' %>>Cash</option>
                  <option value="Finance" <%= machine?.finance_type==='Finance'?'selected':'' %>>Finance</option>
                  <option value="Subsidy" <%= machine?.finance_type==='Subsidy'?'selected':'' %>>Subsidy</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Financier / Bank</label>
                <input name="financier" value="<%= machine?.financier||'' %>" class="form-control">
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Customer Details -->
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-success text-white fw-semibold">
            <i class="bi bi-person me-2"></i>Customer Details
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Customer Name <span class="text-danger">*</span></label>
                <input name="customer_name" value="<%= machine?.customer_name||'' %>" class="form-control" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Contact Person</label>
                <input name="contact_person" value="<%= machine?.contact_person||'' %>" class="form-control">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Mobile 1</label>
                <input name="mobile_1" value="<%= machine?.mobile_1||'' %>" class="form-control" type="tel">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Mobile 2</label>
                <input name="mobile_2" value="<%= machine?.mobile_2||'' %>" class="form-control" type="tel">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold">GST Number</label>
                <input name="gst_number" value="<%= machine?.gst_number||'' %>" class="form-control text-uppercase" maxlength="15">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold">PAN Number</label>
                <input name="pan_number" value="<%= machine?.pan_number||'' %>" class="form-control text-uppercase" maxlength="10">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Place of Supply</label>
                <input name="place_of_supply" value="<%= machine?.place_of_supply||'' %>" class="form-control" placeholder="e.g. UP">
              </div>
              <div class="col-md-12">
                <label class="form-label fw-semibold">Customer Address</label>
                <textarea name="customer_address" class="form-control" rows="2"><%= machine?.customer_address||'' %></textarea>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 d-flex gap-2 justify-content-end">
        <a href="<%= machine ? '/sold-machines/' + machine.id : '/sold-machines' %>" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i><%= machine ? 'Save Changes' : 'Register Machine' %></button>
      </div>
    </div>
  </form>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
