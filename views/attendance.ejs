<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'attendance', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-calendar-check me-2 text-danger"></i>My Attendance</h4>
    <small class="text-muted"><%= todayStr %></small>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error)   { %><div class="alert alert-danger  alert-dismissible"><%= flash.error   %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <!-- Today's status card -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Today — <%= todayStr %></div>
    <div class="card-body text-center py-4">
      <% if (!todayRec || !todayRec.check_in_time) { %>
        <p class="text-muted mb-3">You have <strong>not checked in</strong> today.</p>
        <button class="btn btn-success btn-lg px-5 fw-bold" onclick="startCapture('checkin')">
          <i class="bi bi-box-arrow-in-right me-2"></i>Check In
        </button>
      <% } else if (!todayRec.check_out_time) { %>
        <div class="mb-3">
          <span class="badge bg-success fs-6 mb-2">✓ Checked In</span><br>
          <small class="text-muted">at <%= new Date(todayRec.check_in_time).toLocaleTimeString('en-IN', {hour:'2-digit',minute:'2-digit'}) %></small>
          <% if (todayRec.check_in_lat) { %>
            <small class="text-muted ms-2"><i class="bi bi-geo-alt"></i> <%= todayRec.check_in_lat.toFixed(4) %>, <%= todayRec.check_in_lng.toFixed(4) %></small>
          <% } %>
          <% if (todayRec.check_in_photo) { %>
            <div class="mt-2"><img src="<%= todayRec.check_in_photo %>" style="height:80px;border-radius:8px;border:2px solid #28a745"></div>
          <% } %>
        </div>
        <button class="btn btn-danger btn-lg px-5 fw-bold" onclick="startCapture('checkout')">
          <i class="bi bi-box-arrow-right me-2"></i>Check Out
        </button>
      <% } else { %>
        <div class="row justify-content-center g-3">
          <div class="col-auto text-center">
            <span class="badge bg-success fs-6">✓ Checked In</span><br>
            <small class="text-muted"><%= new Date(todayRec.check_in_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></small>
            <% if (todayRec.check_in_photo) { %><div class="mt-1"><img src="<%= todayRec.check_in_photo %>" style="height:70px;border-radius:8px"></div><% } %>
          </div>
          <div class="col-auto text-center">
            <span class="badge bg-secondary fs-6">✓ Checked Out</span><br>
            <small class="text-muted"><%= new Date(todayRec.check_out_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></small>
            <% if (todayRec.check_out_photo) { %><div class="mt-1"><img src="<%= todayRec.check_out_photo %>" style="height:70px;border-radius:8px"></div><% } %>
          </div>
        </div>
        <p class="text-success fw-bold mt-3 mb-0">✅ Attendance marked for today.</p>
      <% } %>
    </div>
  </div>

  <!-- Camera modal -->
  <div class="modal fade" id="cameraModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="cameraTitle">Take Selfie</h5>
        </div>
        <div class="modal-body text-center">
          <div id="cameraStep1">
            <video id="cameraPreview" autoplay playsinline style="width:100%;border-radius:8px;max-height:300px"></video>
            <div id="gpsStatus" class="mt-2 small text-muted"><i class="bi bi-geo-alt-fill me-1"></i>Getting location…</div>
            <div class="mt-3 d-flex gap-2 justify-content-center">
              <button class="btn btn-danger px-4 fw-bold" onclick="capturePhoto()" id="snapBtn" disabled>
                <i class="bi bi-camera-fill me-1"></i>Snap & Submit
              </button>
              <button class="btn btn-outline-secondary" onclick="cancelCapture()">Cancel</button>
            </div>
          </div>
          <div id="cameraStep2" class="d-none">
            <div class="spinner-border text-danger mb-3"></div>
            <p>Submitting attendance…</p>
          </div>
          <div id="cameraStep3" class="d-none">
            <i class="bi bi-check-circle-fill text-success" style="font-size:3rem"></i>
            <p class="fw-bold mt-2" id="successMsg">Done!</p>
          </div>
          <div id="cameraStep4" class="d-none">
            <i class="bi bi-exclamation-circle-fill text-danger" style="font-size:3rem"></i>
            <p class="fw-bold mt-2" id="errorMsg">Error</p>
            <button class="btn btn-outline-danger" onclick="cancelCapture()">Close</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 30-day history -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Last 30 Days</div>
    <div class="table-responsive">
      <table class="table table-sm table-hover mb-0">
        <thead class="table-light"><tr><th>Date</th><th>Check In</th><th>Check Out</th><th>Hours</th><th>Status</th></tr></thead>
        <tbody>
          <% history.forEach(r => {
            const ci = r.check_in_time  ? new Date(r.check_in_time)  : null;
            const co = r.check_out_time ? new Date(r.check_out_time) : null;
            const hrs = (ci && co) ? ((co - ci) / 3600000).toFixed(1) : '—';
          %>
          <tr>
            <td class="fw-semibold"><%= r.date %></td>
            <td><%= ci ? ci.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) : '—' %></td>
            <td><%= co ? co.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) : '—' %></td>
            <td><%= hrs %></td>
            <td>
              <% if (r.check_in_time && r.check_out_time) { %>
                <span class="badge bg-success">Present</span>
              <% } else if (r.check_in_time) { %>
                <span class="badge bg-warning text-dark">In Progress</span>
              <% } else { %>
                <span class="badge bg-secondary">Absent</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
          <% if (!history.length) { %><tr><td colspan="5" class="text-center text-muted py-3">No attendance records yet.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
let _stream = null, _lat = null, _lng = null, _type = null;

async function startCapture(type) {
  _type = type;
  _lat  = null; _lng = null;
  document.getElementById('cameraTitle').textContent = type === 'checkin' ? 'Check In — Take Selfie' : 'Check Out — Take Selfie';
  document.getElementById('snapBtn').disabled = true;
  ['cameraStep2','cameraStep3','cameraStep4'].forEach(id => document.getElementById(id).classList.add('d-none'));
  document.getElementById('cameraStep1').classList.remove('d-none');
  document.getElementById('gpsStatus').innerHTML = '<i class="bi bi-geo-alt-fill me-1"></i>Getting location…';
  new bootstrap.Modal(document.getElementById('cameraModal')).show();

  try {
    _stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width:{ideal:480}, height:{ideal:480} }, audio: false });
    document.getElementById('cameraPreview').srcObject = _stream;
  } catch(e) {
    alert('Camera not available: ' + e.message); cancelCapture(); return;
  }

  navigator.geolocation.getCurrentPosition(pos => {
    _lat = pos.coords.latitude; _lng = pos.coords.longitude;
    document.getElementById('gpsStatus').innerHTML = '<i class="bi bi-geo-alt-fill text-success me-1"></i>Location: ' + _lat.toFixed(4) + ', ' + _lng.toFixed(4);
    document.getElementById('snapBtn').disabled = false;
  }, err => {
    document.getElementById('gpsStatus').innerHTML = '<i class="bi bi-exclamation-triangle text-warning me-1"></i>Location unavailable — proceeding without GPS.';
    document.getElementById('snapBtn').disabled = false;
  }, { enableHighAccuracy: true, timeout: 10000 });
}

async function capturePhoto() {
  const video = document.getElementById('cameraPreview');
  const canvas = document.createElement('canvas'); canvas.width = 480; canvas.height = 480;
  canvas.getContext('2d').drawImage(video, 0, 0, 480, 480);
  const photo = canvas.toDataURL('image/jpeg', 0.7);

  if (_stream) { _stream.getTracks().forEach(t => t.stop()); _stream = null; }
  document.getElementById('cameraStep1').classList.add('d-none');
  document.getElementById('cameraStep2').classList.remove('d-none');

  try {
    // Upload photo
    const up = await fetch('/api/upload', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ data: photo, folder: 'attendance' })
    }).then(r=>r.json());

    // Submit check-in/out
    const resp = await fetch('/attendance/api/' + _type, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ lat: _lat, lng: _lng, photo: up.path || '' })
    }).then(r=>r.json());

    document.getElementById('cameraStep2').classList.add('d-none');
    if (resp.ok) {
      document.getElementById('cameraStep3').classList.remove('d-none');
      document.getElementById('successMsg').textContent = _type === 'checkin' ? 'Checked In Successfully!' : 'Checked Out Successfully!';
      setTimeout(() => location.reload(), 1500);
    } else {
      document.getElementById('cameraStep4').classList.remove('d-none');
      document.getElementById('errorMsg').textContent = resp.message || 'Error. Please try again.';
    }
  } catch(e) {
    document.getElementById('cameraStep2').classList.add('d-none');
    document.getElementById('cameraStep4').classList.remove('d-none');
    document.getElementById('errorMsg').textContent = 'Network error. Please try again.';
  }
}

function cancelCapture() {
  if (_stream) { _stream.getTracks().forEach(t => t.stop()); _stream = null; }
  bootstrap.Modal.getInstance(document.getElementById('cameraModal'))?.hide();
}
</script>
</body></html>
