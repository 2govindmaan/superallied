<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'solar-quotations', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-sun me-2 text-warning"></i>Solar Customers</h4>
    <div class="d-flex gap-2">
      <a href="/solar-quotations" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quotations</a>
      <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#addModal"><i class="bi bi-plus-lg me-1"></i>Add Customer</button>
    </div>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
      <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4"><input name="q" value="<%= q %>" class="form-control form-control-sm" placeholder="Search by name, phone, consumer no…"></div>
        <div class="col-auto">
          <button class="btn btn-outline-secondary btn-sm">Search</button>
          <a href="/solar-quotations/customers" class="btn btn-outline-secondary btn-sm">Clear</a>
        </div>
      </form>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><span class="fw-semibold">Customers (<%= customers.length %>)</span></div>
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Consumer No</th>
            <th>Consumer Type</th>
            <th>Sanction Load</th>
            <th>Address</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!customers.length) { %>
          <tr><td colspan="7" class="text-center text-muted py-4">No customers found.</td></tr>
          <% } %>
          <% customers.forEach(c => { %>
          <tr>
            <td class="fw-semibold"><%= c.name %></td>
            <td><%= c.phone || '-' %></td>
            <td><%= c.consumer_number || '-' %></td>
            <td><%= c.consumer_type || '-' %></td>
            <td><%= c.sanction_load || '-' %></td>
            <td class="text-truncate" style="max-width:200px"><%= c.address || '-' %></td>
            <td>
              <a href="/solar-quotations/new?customer_id=<%= c.id %>" class="btn btn-sm btn-warning me-1" title="New Quotation"><i class="bi bi-file-earmark-plus"></i></a>
              <button class="btn btn-sm btn-outline-secondary me-1" onclick='editCustomer(<%- JSON.stringify(c) %>)' title="Edit"><i class="bi bi-pencil"></i></button>
              <form method="post" action="/solar-quotations/customers/<%= c.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this customer?')">
                <button class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
  <div class="modal-dialog">
    <form method="post" action="/solar-quotations/customers">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Add Solar Customer</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <div class="mb-2"><label class="form-label fw-semibold">Name *</label><input name="name" class="form-control" required></div>
          <div class="mb-2"><label class="form-label">Phone</label><input name="phone" class="form-control"></div>
          <div class="mb-2"><label class="form-label">Address</label><textarea name="address" class="form-control" rows="2"></textarea></div>
          <div class="row g-2 mb-2">
            <div class="col"><label class="form-label">Consumer No</label><input name="consumer_number" class="form-control"></div>
            <div class="col"><label class="form-label">Consumer Type</label><input name="consumer_type" class="form-control" placeholder="LMV-1"></div>
          </div>
          <div class="row g-2 mb-2">
            <div class="col"><label class="form-label">Sanction Load</label><input name="sanction_load" class="form-control" placeholder="3 KW"></div>
            <div class="col"><label class="form-label">Email</label><input name="email" class="form-control" type="email"></div>
          </div>
          <div class="mb-2"><label class="form-label">Notes</label><textarea name="notes" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-warning">Save</button></div>
      </div>
    </form>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
  <div class="modal-dialog">
    <form method="post" id="editForm">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title">Edit Customer</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <div class="mb-2"><label class="form-label fw-semibold">Name *</label><input id="eName" name="name" class="form-control" required></div>
          <div class="mb-2"><label class="form-label">Phone</label><input id="ePhone" name="phone" class="form-control"></div>
          <div class="mb-2"><label class="form-label">Address</label><textarea id="eAddress" name="address" class="form-control" rows="2"></textarea></div>
          <div class="row g-2 mb-2">
            <div class="col"><label class="form-label">Consumer No</label><input id="eConsNo" name="consumer_number" class="form-control"></div>
            <div class="col"><label class="form-label">Consumer Type</label><input id="eConsType" name="consumer_type" class="form-control"></div>
          </div>
          <div class="row g-2 mb-2">
            <div class="col"><label class="form-label">Sanction Load</label><input id="eSanction" name="sanction_load" class="form-control"></div>
            <div class="col"><label class="form-label">Email</label><input id="eEmail" name="email" class="form-control" type="email"></div>
          </div>
          <div class="mb-2"><label class="form-label">Notes</label><textarea id="eNotes" name="notes" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-warning">Update</button></div>
      </div>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function editCustomer(c) {
  document.getElementById('editForm').action = '/solar-quotations/customers/' + c.id + '/update';
  document.getElementById('eName').value     = c.name || '';
  document.getElementById('ePhone').value    = c.phone || '';
  document.getElementById('eAddress').value  = c.address || '';
  document.getElementById('eConsNo').value   = c.consumer_number || '';
  document.getElementById('eConsType').value = c.consumer_type || '';
  document.getElementById('eSanction').value = c.sanction_load || '';
  document.getElementById('eEmail').value    = c.email || '';
  document.getElementById('eNotes').value    = c.notes || '';
  new bootstrap.Modal(document.getElementById('editModal')).show();
}
</script>
</body></html>
