<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'solar-quotations', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h4 class="mb-0 fw-bold"><i class="bi bi-sun-fill me-2 text-warning"></i><%= q.quotation_no %></h4>
      <small class="text-muted"><%= q.customer_name %> &bull; <%= q.system_capacity %> KW <%= q.system_type %></small>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <%
        const phone = (q.customer_phone||'').replace(/\D/g,'');
        const capStr = q.system_capacity ? q.system_capacity + ' KW ' : '';
        const waText = encodeURIComponent(
          'Dear ' + q.customer_name + ',\n\nPlease find your solar quotation details below:\n\n' +
          'Quotation No: ' + q.quotation_no + '\n' +
          'System: ' + capStr + q.system_type + '\n' +
          'Grand Total: ₹' + Number(q.grand_total).toLocaleString('en-IN') + '\n\n' +
          (q.notes ? 'Notes:\n' + q.notes + '\n\n' : '') +
          'For any queries please contact us.\n\nThank you!'
        );
        const waPhone = phone.length === 10 ? '91' + phone : phone;
      %>
      <% if (phone) { %>
      <a href="https://wa.me/<%= waPhone %>?text=<%= waText %>" target="_blank" class="btn btn-success">
        <i class="bi bi-whatsapp me-1"></i>Share on WhatsApp
      </a>
      <% } %>
      <a href="/solar-quotations/<%= q.id %>/pdf" target="_blank" class="btn btn-outline-danger">
        <i class="bi bi-file-pdf me-1"></i>PDF
      </a>
      <a href="/solar-quotations/<%= q.id %>/edit" class="btn btn-outline-warning">
        <i class="bi bi-pencil me-1"></i>Edit
      </a>
      <% if (isAdmin) { %>
      <form method="post" action="/solar-quotations/<%= q.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this quotation?')">
        <button class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
      </form>
      <% } %>
      <a href="/solar-quotations" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-warning bg-opacity-10"><span class="fw-semibold">Customer Details</span></div>
        <div class="card-body">
          <table class="table table-sm mb-0">
            <tr><td class="text-muted" style="width:40%">Name</td><td class="fw-semibold"><%= q.customer_name %></td></tr>
            <tr><td class="text-muted">Phone</td><td><%= q.customer_phone || '-' %></td></tr>
            <tr><td class="text-muted">Address</td><td><%= q.customer_address || '-' %></td></tr>
            <tr><td class="text-muted">Consumer No</td><td><%= q.consumer_number || '-' %></td></tr>
            <tr><td class="text-muted">Consumer Type</td><td><%= q.consumer_type || '-' %></td></tr>
            <tr><td class="text-muted">Sanction Load</td><td><%= q.sanction_load || '-' %></td></tr>
            <tr><td class="text-muted">Email</td><td><%= q.customer_email || '-' %></td></tr>
          </table>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-warning bg-opacity-10"><span class="fw-semibold">Quotation Details</span></div>
        <div class="card-body">
          <table class="table table-sm mb-0">
            <tr><td class="text-muted" style="width:40%">Quotation No</td><td class="fw-bold"><%= q.quotation_no %></td></tr>
            <tr><td class="text-muted">Date</td><td><%= q.quotation_date ? new Date(q.quotation_date).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) : '-' %></td></tr>
            <tr><td class="text-muted">System Type</td><td><span class="badge bg-<%= q.system_type==='ONGRID'?'success':q.system_type==='OFFGRID'?'secondary':'info' %>"><%= q.system_type %></span></td></tr>
            <tr><td class="text-muted">Capacity</td><td><%= q.system_capacity %> KW</td></tr>
            <tr><td class="text-muted">Status</td>
              <td>
                <form method="post" action="/solar-quotations/<%= q.id %>/status" class="d-flex gap-1">
                  <select name="status" class="form-select form-select-sm" style="width:auto">
                    <% ['draft','sent','approved','rejected','converted'].forEach(st => { %>
                    <option value="<%= st %>" <%= q.status===st?'selected':'' %>><%= st.charAt(0).toUpperCase()+st.slice(1) %></option>
                    <% }) %>
                  </select>
                  <button class="btn btn-sm btn-outline-secondary">Update</button>
                </form>
              </td>
            </tr>
            <tr><td class="text-muted">Created By</td><td><%= q.creator_name || '-' %></td></tr>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Items (internal) -->
  <% if (items.length) { %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-light d-flex justify-content-between">
      <span class="fw-semibold">Components (Internal Record)</span>
      <span class="badge bg-secondary">Not shown on customer quotation</span>
    </div>
    <div class="table-responsive">
      <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Part No</th>
            <th>Description</th>
            <th class="text-center">Qty</th>
            <th class="text-end">Rate</th>
            <th class="text-center">GST%</th>
            <th class="text-end">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach((it, i) => { %>
          <tr>
            <td><%= i+1 %></td>
            <td><code><%= it.part_no||'-' %></code></td>
            <td><%= it.description %></td>
            <td class="text-center"><%= it.qty %></td>
            <td class="text-end">₹<%= formatINR(it.rate) %></td>
            <td class="text-center"><%= it.gst_rate %>%</td>
            <td class="text-end">₹<%= formatINR(it.amount) %></td>
          </tr>
          <% }) %>
        </tbody>
        <tfoot class="table-light fw-semibold">
          <tr>
            <td colspan="6" class="text-end">Sub-total</td>
            <td class="text-end">₹<%= formatINR(items.reduce((s,it)=>s+it.amount,0)) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
  <% } %>

  <!-- Grand Total -->
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-warning bg-opacity-10"><span class="fw-semibold">Pricing</span></div>
    <div class="card-body">
      <div class="row justify-content-end">
        <div class="col-md-4">
          <table class="table table-sm mb-0">
            <tr><td>Total Amount</td><td class="text-end">₹<%= formatINR(q.total_amount) %></td></tr>
            <% if (q.discount_amount > 0) { %>
            <tr><td class="text-danger">Discount</td><td class="text-end text-danger">- ₹<%= formatINR(q.discount_amount) %></td></tr>
            <% } %>
            <tr class="fw-bold fs-5"><td>Grand Total</td><td class="text-end text-warning">₹<%= formatINR(q.grand_total) %></td></tr>
          </table>
          <div class="text-muted small mt-1 fst-italic"><%= numberToWords(Math.round(q.grand_total)) %></div>
        </div>
      </div>
    </div>
  </div>

  <% if (q.notes) { %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-warning bg-opacity-10"><span class="fw-semibold">Notes</span></div>
    <div class="card-body" style="white-space:pre-wrap"><%= q.notes %></div>
  </div>
  <% } %>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
