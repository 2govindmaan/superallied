<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'leads', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-funnel-fill text-danger me-2"></i>Lead Management</h4>
    <div class="d-flex gap-2">
      <a href="/leads/pipeline" class="btn btn-outline-secondary btn-sm"><i class="bi bi-kanban me-1"></i>Pipeline</a>
      <a href="/leads/dashboard" class="btn btn-outline-secondary btn-sm"><i class="bi bi-bar-chart me-1"></i>Dashboard</a>
      <a href="/leads/new" class="btn btn-danger btn-sm"><i class="bi bi-plus-lg me-1"></i>New Lead</a>
    </div>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible py-2"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible py-2"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <!-- Stage quick-filter pills -->
  <div class="d-flex flex-wrap gap-2 mb-3">
    <a href="/leads?status=active" class="badge rounded-pill text-decoration-none fs-6 <%= !stage && status==='active' ? 'bg-dark' : 'bg-secondary' %>">
      All Active
    </a>
    <% for(let s=1; s<=5; s++) { %>
    <a href="/leads?stage=<%= s %>&status=active" class="badge rounded-pill text-decoration-none fs-6 <%= stage==s ? 'bg-danger' : 'bg-light text-dark border' %>">
      S<%= s %>: <%- STAGES[s].label %> <span class="badge bg-white text-dark ms-1"><%= stageCounts[s] %></span>
    </a>
    <% } %>
    <a href="/leads?status=won" class="badge rounded-pill text-decoration-none fs-6 <%= status==='won' ? 'bg-success' : 'bg-light text-dark border' %>">Won <span class="badge bg-white text-dark ms-1"><%= wonCount %></span></a>
    <a href="/leads?status=lost" class="badge rounded-pill text-decoration-none fs-6 <%= status==='lost' ? 'bg-danger' : 'bg-light text-dark border' %>">Lost <span class="badge bg-white text-dark ms-1"><%= lostCount %></span></a>
  </div>

  <!-- Filters -->
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
      <form method="get" class="row g-2 align-items-end">
        <input type="hidden" name="status" value="<%= status %>">
        <div class="col-12 col-md-4">
          <input type="text" class="form-control form-control-sm" name="q" value="<%= q %>" placeholder="Search customer, phone, lead#…">
        </div>
        <div class="col-6 col-md-2">
          <select class="form-select form-select-sm" name="stage">
            <option value="">All Stages</option>
            <% for(let s=1;s<=5;s++){ %><option value="<%= s %>" <%= stage==s?'selected':'' %>>Stage <%= s %></option><% } %>
          </select>
        </div>
        <div class="col-6 col-md-2">
          <input type="text" class="form-control form-control-sm" name="model" value="<%= model %>" placeholder="Model (e.g. SD-76)">
        </div>
        <div class="col-auto">
          <button class="btn btn-sm btn-danger" type="submit"><i class="bi bi-search me-1"></i>Filter</button>
          <a href="/leads" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
        </div>
      </form>
    </div>
  </div>

  <!-- Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
      <span class="fw-semibold text-muted small"><%= leads.length %> leads found</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0 small">
        <thead class="table-light">
          <tr>
            <th>Lead #</th>
            <th>Customer</th>
            <th>Model</th>
            <th>Location</th>
            <th>Category</th>
            <th>Stage</th>
            <th>Status</th>
            <% if(allAccess) { %><th>Created By</th><% } %>
            <th>Expected</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!leads.length) { %>
          <tr><td colspan="10" class="text-center text-muted py-4">No leads found. <a href="/leads/new">Create one</a></td></tr>
          <% } %>
          <% leads.forEach(l => { %>
          <tr>
            <td><a href="/leads/<%= l.id %>" class="fw-semibold text-danger text-decoration-none"><%= l.lead_number %></a></td>
            <td>
              <div class="fw-semibold"><%= l.customer_name %></div>
              <% if(l.customer_phone) { %><small class="text-muted"><%= l.customer_phone %></small><% } %>
            </td>
            <td><%= l.model_required || '—' %></td>
            <td>
              <div><%= l.dealer_location || l.district || '—' %></div>
              <% if(l.state) { %><small class="text-muted"><%= l.state %></small><% } %>
            </td>
            <td>
              <span class="badge <%= l.customer_category==='RTB'?'bg-success-subtle text-success':'bg-primary-subtle text-primary' %>"><%= l.customer_category %></span>
            </td>
            <td>
              <% if(l.status === 'won') { %>
                <span class="badge bg-success">Won</span>
              <% } else if(l.status === 'lost') { %>
                <span class="badge bg-danger">Lost</span>
              <% } else { %>
                <span class="badge bg-<%= ['','primary','info','warning','danger','success'][l.current_stage] || 'secondary' %>">
                  S<%= l.current_stage %>: <%= STAGES[l.current_stage]?.label || '' %>
                </span>
              <% } %>
            </td>
            <td>
              <span class="badge <%= l.status==='active'?'bg-light text-dark border':l.status==='won'?'bg-success':'bg-danger' %>">
                <%= l.status.charAt(0).toUpperCase()+l.status.slice(1) %>
              </span>
            </td>
            <% if(allAccess) { %>
            <td><small class="text-muted"><%= l.creator_name || '—' %></small></td>
            <% } %>
            <td>
              <% if(l.expected_purchase_date) { %>
                <small class="<%= new Date(l.expected_purchase_date) < new Date() ? 'text-danger' : 'text-muted' %>">
                  <%= new Date(l.expected_purchase_date).toLocaleDateString('en-IN') %>
                </small>
              <% } else { %>—<% } %>
            </td>
            <td>
              <a href="/leads/<%= l.id %>" class="btn btn-xs btn-outline-secondary py-0 px-1"><i class="bi bi-eye"></i></a>
              <a href="/leads/<%= l.id %>/edit" class="btn btn-xs btn-outline-primary py-0 px-1"><i class="bi bi-pencil"></i></a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
