<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: Arial, sans-serif; font-size: 11px; color: #1a1a1a; background: #fff; }
  .page { width: 210mm; min-height: 297mm; padding: 12mm 14mm; position: relative; }
  .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid #c00; padding-bottom: 10px; margin-bottom: 10px; }
  .company h1 { font-size: 22px; font-weight: 900; color: #c00; letter-spacing: 1px; }
  .company p { font-size: 10px; color: #555; margin-top: 2px; }
  .logo-wrap img { height: 55px; }
  .qr-wrap img { height: 60px; }
  .doc-title { text-align: center; background: #c00; color: #fff; padding: 5px; font-size: 14px; font-weight: 700; letter-spacing: 2px; margin-bottom: 10px; }
  .meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 10px; }
  .meta-box { border: 1px solid #ddd; padding: 6px 8px; border-radius: 3px; }
  .meta-box h4 { font-size: 9px; text-transform: uppercase; color: #888; letter-spacing: 1px; margin-bottom: 4px; border-bottom: 1px solid #eee; padding-bottom: 3px; }
  .meta-box dl { display: grid; grid-template-columns: 110px 1fr; font-size: 10px; gap: 2px 4px; }
  .meta-box dt { color: #666; }
  .meta-box dd { font-weight: 600; }
  table.items { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
  table.items thead th { background: #2c3e50; color: #fff; padding: 5px 4px; font-size: 9px; text-transform: uppercase; }
  table.items tbody tr:nth-child(even) { background: #f9f9f9; }
  table.items tbody td { padding: 4px; font-size: 10px; border-bottom: 1px solid #eee; vertical-align: middle; }
  table.items tfoot td { border-top: 2px solid #2c3e50; padding: 4px; font-size: 10px; }
  .text-right { text-align: right; }
  .text-center { text-align: center; }
  .totals-section { display: flex; justify-content: flex-end; }
  .totals-table { width: 240px; border-collapse: collapse; }
  .totals-table td { padding: 3px 6px; font-size: 10px; }
  .totals-table .grand { background: #c00; color: #fff; font-size: 12px; font-weight: 700; }
  .amount-words { background: #f5f5f5; border-left: 3px solid #c00; padding: 5px 8px; margin: 8px 0; font-size: 10px; }
  .terms { font-size: 9px; color: #555; margin-top: 8px; }
  .terms h4 { font-size: 10px; font-weight: 700; margin-bottom: 3px; }
  .footer { position: absolute; bottom: 12mm; left: 14mm; right: 14mm; border-top: 1px solid #ddd; padding-top: 6px; display: flex; justify-content: space-between; font-size: 9px; color: #888; }
  .sig-box { text-align: center; border-top: 1px solid #555; padding-top: 3px; margin-top: 20px; font-size: 9px; }
  .badge-status { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; }
  .code { font-family: 'Courier New', monospace; }
</style>
</head>
<body>
<div class="page">

  <!-- Header -->
  <div class="header">
    <div class="company">
      <% if (logoB64) { %><img src="<%= logoB64 %>" style="height:50px;margin-bottom:4px"><br><% } %>
      <h1><%= settings.company_name || 'SUPER ALLIED' %></h1>
      <p>Authorised Dealer — <%= settings.dealer_of || 'Bull Construction Equipment Pvt. Ltd.' %></p>
      <p style="margin-top:2px"><%= settings.company_address || '' %></p>
      <p style="margin-top:2px">GSTIN: <strong><%= settings.company_gstin || '' %></strong> &nbsp;|&nbsp; Contact: <%= settings.contact_phone || '' %></p>
    </div>
    <div style="text-align:right">
      <% if (qrDataUrl) { %><img src="<%= qrDataUrl %>" style="height:60px"><% } %>
    </div>
  </div>

  <div class="doc-title">SPARE PARTS QUOTATION</div>

  <!-- Meta -->
  <div class="meta-grid">
    <div class="meta-box">
      <h4>Customer Details</h4>
      <dl>
        <dt>Customer Name</dt><dd><%= q.customer_name %></dd>
        <dt>Machine No</dt><dd class="code"><%= q.machine_no || '—' %></dd>
        <% if (q.contact_person) { %><dt>Contact Person</dt><dd><%= q.contact_person %></dd><% } %>
        <% if (q.mobile) { %><dt>Mobile</dt><dd><%= q.mobile %></dd><% } %>
        <% if (q.customer_address) { %><dt>Address</dt><dd><%= q.customer_address %></dd><% } %>
        <% if (q.customer_gstin) { %><dt>GSTIN</dt><dd class="code"><%= q.customer_gstin %></dd><% } %>
        <% if (q.place_of_supply) { %><dt>Place of Supply</dt><dd><%= q.place_of_supply %></dd><% } %>
      </dl>
    </div>
    <div class="meta-box">
      <h4>Quotation Details</h4>
      <dl>
        <dt>Quotation No</dt><dd class="code" style="color:#c00;font-weight:900"><%= q.quotation_no %></dd>
        <dt>Date</dt><dd><%= new Date(q.created_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></dd>
        <dt>Valid Until</dt><dd>
          <% const validDate = new Date(q.created_at); validDate.setDate(validDate.getDate() + (q.validity_days||30)); %>
          <%= validDate.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %>
        </dd>
        <dt>Tax Mode</dt><dd><%= q.tax_mode === 'IGST' ? 'IGST' : 'CGST + SGST' %></dd>
        <% if (q.salesperson) { %><dt>Salesperson</dt><dd><%= q.salesperson %></dd><% } %>
      </dl>
    </div>
  </div>

  <!-- Items Table -->
  <table class="items">
    <thead>
      <tr>
        <th class="text-center">#</th>
        <th>Part No</th>
        <th>Description</th>
        <th class="text-center">HSN</th>
        <th class="text-center">Qty</th>
        <th class="text-right">Basic Rate</th>
        <th class="text-right">Disc%</th>
        <th class="text-center">Tax%</th>
        <th class="text-right">Tax Amt</th>
        <th class="text-right">Line Total</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach((it, i) => { %>
      <tr>
        <td class="text-center text-muted"><%= i+1 %></td>
        <td class="code" style="font-size:9px"><%= it.part_no || '—' %></td>
        <td style="font-weight:600"><%= it.description %></td>
        <td class="text-center"><%= it.hsn || '—' %></td>
        <td class="text-center"><%= it.qty %></td>
        <td class="text-right">₹<%= formatINR(it.basic_rate) %></td>
        <td class="text-right"><%= it.discount_percent ? it.discount_percent + '%' : '—' %></td>
        <td class="text-center"><%= it.tax_rate %>%</td>
        <td class="text-right">₹<%= formatINR(it.tax_amount) %></td>
        <td class="text-right" style="font-weight:700">₹<%= formatINR(it.line_total) %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <!-- Totals -->
  <div class="totals-section">
    <table class="totals-table">
      <tr><td>Total Basic</td><td class="text-right">₹<%= formatINR(q.total_basic) %></td></tr>
      <% if (q.tax_mode === 'IGST') { %>
      <tr><td>IGST</td><td class="text-right">₹<%= formatINR(q.total_gst) %></td></tr>
      <% } else { %>
      <tr><td>CGST</td><td class="text-right">₹<%= formatINR(q.total_gst/2) %></td></tr>
      <tr><td>SGST</td><td class="text-right">₹<%= formatINR(q.total_gst/2) %></td></tr>
      <% } %>
      <tr class="grand"><td>GRAND TOTAL</td><td class="text-right">₹<%= formatINR(q.grand_total) %></td></tr>
    </table>
  </div>

  <div class="amount-words">
    Amount in Words: <strong><%= numberToWords(Math.round(q.grand_total)) %></strong>
  </div>

  <!-- Bank Details -->
  <% if (settings.bank_account) { %>
  <div style="border:1px solid #ddd;padding:5px 8px;font-size:9px;margin-bottom:6px;border-radius:3px">
    <strong>Bank Details:</strong> <%= settings.bank_beneficiary %> &nbsp;|&nbsp;
    A/C: <span class="code"><%= settings.bank_account %></span> &nbsp;|&nbsp;
    IFSC: <span class="code"><%= settings.bank_ifsc %></span> &nbsp;|&nbsp;
    Branch: <%= settings.bank_branch %>
  </div>
  <% } %>

  <!-- Terms -->
  <% if (q.terms) { %>
  <div class="terms">
    <h4>Terms & Conditions</h4>
    <div style="white-space:pre-line"><%= q.terms %></div>
  </div>
  <% } %>

  <!-- Signature -->
  <div style="display:flex;justify-content:flex-end;margin-top:16px">
    <div class="sig-box" style="width:180px">
      For <%= settings.company_name || 'Super Allied' %><br>
      Authorised Signatory
    </div>
  </div>

  <div class="footer">
    <span><%= settings.company_name %> | <%= settings.company_address %></span>
    <span>This is a computer generated quotation — no signature required</span>
  </div>
</div>
</body></html>
