<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'spare-quotations', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-receipt-cutoff me-2 text-success"></i>Spare Part Quotations</h4>
    <a href="/spare-quotations/new" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>New Quotation</a>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <!-- Filters -->
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
      <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
          <input name="q" value="<%= q %>" class="form-control form-control-sm" placeholder="Search quotation, customer, machine…">
        </div>
        <div class="col-md-2">
          <select name="status" class="form-select form-select-sm">
            <option value="">All Status</option>
            <option value="draft" <%= status==='draft'?'selected':'' %>>Draft</option>
            <option value="sent" <%= status==='sent'?'selected':'' %>>Sent</option>
            <option value="approved" <%= status==='approved'?'selected':'' %>>Approved</option>
            <option value="rejected" <%= status==='rejected'?'selected':'' %>>Rejected</option>
            <option value="converted" <%= status==='converted'?'selected':'' %>>Converted</option>
          </select>
        </div>
        <div class="col-md-2">
          <input type="date" name="from" value="<%= from %>" class="form-control form-control-sm" placeholder="From">
        </div>
        <div class="col-md-2">
          <input type="date" name="to" value="<%= to %>" class="form-control form-control-sm" placeholder="To">
        </div>
        <div class="col-auto">
          <button class="btn btn-outline-secondary btn-sm">Filter</button>
          <a href="/spare-quotations" class="btn btn-outline-secondary btn-sm">Clear</a>
        </div>
        <div class="col-auto ms-auto">
          <a href="/spare-quotations/reports/summary?from=<%= from %>&to=<%= to %>" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-bar-chart me-1"></i>Reports
          </a>
        </div>
      </form>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
      <span class="fw-semibold">Quotations (<%= quotations.length %>)</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Quotation No</th>
            <th>Machine No</th>
            <th>Customer</th>
            <th>Date</th>
            <th class="text-end">Basic</th>
            <th class="text-end">GST</th>
            <th class="text-end">Grand Total</th>
            <th>Status</th>
            <th>By</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!quotations.length) { %>
          <tr><td colspan="10" class="text-center text-muted py-4">No quotations found. <a href="/spare-quotations/new">Create the first one.</a></td></tr>
          <% } %>
          <% quotations.forEach(q => { %>
          <tr>
            <td><a href="/spare-quotations/<%= q.id %>" class="fw-semibold text-decoration-none"><%= q.quotation_no %></a></td>
            <td><% if (q.machine_no) { %><a href="/sold-machines" class="text-decoration-none font-monospace small"><%= q.machine_no %></a><% } else { %>—<% } %></td>
            <td>
              <div class="fw-semibold"><%= q.customer_name %></div>
              <small class="text-muted"><%= q.mobile || '' %></small>
            </td>
            <td><small><%= new Date(q.created_at).toLocaleDateString('en-IN') %></small></td>
            <td class="text-end small">₹<%= formatINR(q.total_basic) %></td>
            <td class="text-end small">₹<%= formatINR(q.total_gst) %></td>
            <td class="text-end fw-semibold">₹<%= formatINR(q.grand_total) %></td>
            <td>
              <% const sc = {draft:'bg-secondary',sent:'bg-primary',approved:'bg-success',rejected:'bg-danger',converted:'bg-info'}; %>
              <span class="badge <%= sc[q.status]||'bg-secondary' %>"><%= q.status %></span>
            </td>
            <td><small class="text-muted"><%= q.creator_name || '' %></small></td>
            <td>
              <div class="d-flex gap-1">
                <a href="/spare-quotations/<%= q.id %>/pdf" class="btn btn-sm btn-outline-danger" title="PDF"><i class="bi bi-file-pdf"></i></a>
                <a href="/spare-quotations/<%= q.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                <form method="post" action="/spare-quotations/<%= q.id %>/clone"><button class="btn btn-sm btn-outline-primary" title="Clone"><i class="bi bi-copy"></i></button></form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
